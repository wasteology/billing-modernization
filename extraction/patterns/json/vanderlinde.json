{
  "format_label": "vanderlinde",
  "vendor_name": "Van Der Linde Recycling",
  "routing_regex": "vanderlinderecycling\\.com",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "Invoice\\s*#\\s*(?P<invoice_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "Work\\s+Order\\s+#:\\s*(?P<account_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "Date:\\s*(?P<invoice_date>[A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "Total:\\s*\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "Date\\s+Item\\s*/\\s*Description\\s+Qty\\s+Rate\\s+Amount[^\\n]*\\n(.*)Total:",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "Northrop\\s+Grumman\\s+(?P<service_address>\\d+[^\\n]+?)(?:\\s+(?:Date|Due):.*)?$",
      "flags": [
        "IGNORECASE",
        "MULTILINE"
      ],
      "field_map": {
        "service_address": "service_address"
      }
    },
    {
      "name": "service_address_harmonics",
      "method": "search",
      "pattern": "Harmonics\\s+(?P<service_address>\\d+[^\\n]+?)(?:\\s+Due:|\\s*$)",
      "flags": [
        "IGNORECASE",
        "MULTILINE"
      ],
      "field_map": {
        "service_address": "service_address"
      },
      "skip_if_set": ["service_address"]
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%B %d, %Y",
        "%B %d %Y",
        "%b %d, %Y",
        "%b %d %Y"
      ]
    },
    "date_service": {
      "type": "date_parse",
      "field": "service_date",
      "formats": [
        "%m/%d"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "40yd",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "can pull",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "pull",
          "label": "ROLL_OFF"
        }
      ],
      "default": ""
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycl",
          "label": "RECYCLING"
        },
        {
          "keywords": "leed",
          "label": "RECYCLING"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        },
        {
          "keywords": "wood",
          "label": "C&D"
        },
        {
          "keywords": "concrete",
          "label": "C&D"
        }
      ],
      "default": "MSW"
    },
    "size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "(\\d+\\s*[Yy][Dd])",
      "flags": [
        "IGNORECASE"
      ]
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "fuel",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "surcharge",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "epa",
          "label": "Environmental Surcharge"
        },
        {
          "keywords": "deq",
          "label": "Environmental Surcharge"
        },
        {
          "keywords": "environmental",
          "label": "Environmental Surcharge"
        },
        {
          "keywords": "rental",
          "label": "Container Rental"
        },
        {
          "keywords": "tipping",
          "label": "Disposal"
        },
        {
          "keywords": "disposal",
          "label": "Disposal"
        },
        {
          "keywords": "pull",
          "label": "Haul"
        },
        {
          "keywords": "haul",
          "label": "Haul"
        }
      ],
      "default": "Scheduled Service"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "rental",
          "label": "RENTAL"
        },
        {
          "keywords": "pull",
          "label": "ON_CALL"
        },
        {
          "keywords": "haul",
          "label": "ON_CALL"
        },
        {
          "keywords": "tipping",
          "label": "ON_CALL"
        },
        {
          "keywords": "disposal",
          "label": "ON_CALL"
        },
        {
          "keywords": "fuel",
          "label": "SURCHARGE"
        },
        {
          "keywords": "surcharge",
          "label": "SURCHARGE"
        },
        {
          "keywords": "epa",
          "label": "SURCHARGE"
        },
        {
          "keywords": "deq",
          "label": "SURCHARGE"
        },
        {
          "keywords": "environmental",
          "label": "SURCHARGE"
        }
      ],
      "default": "ON_CALL"
    },
    "weight_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "weight",
      "pattern": "Weight:\\s*([\\d.]+)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "parent_inherit": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "both"
    },
    "schedule_oncall": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "rules": [
        {
          "keywords": "roll_off",
          "label": "ON_CALL"
        },
        {
          "keywords": "compactor",
          "label": "ON_CALL"
        }
      ]
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "body_strip": [
      {
        "pattern": "(\\d+):(\\d{2})(?=\\s|$)",
        "replacement": "\\1.\\2",
        "flags": [
          "MULTILINE"
        ]
      }
    ],
    "charge_detect": {
      "date_pattern": "(\\d{1,2}/\\d{2})",
      "date_format": "{0}",
      "require_date": false
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total",
      "weight_pattern": "Weight:\\s*([\\d.]+)"
    },
    "skip_patterns": [
      "^\\s*In:",
      "Sub\\s*Total",
      "^\\s*$"
    ],
    "per_charge_transforms": [
      "equipment_detect",
      "schedule_oncall",
      "material_detect",
      "size_extract",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": [
      "parent_inherit"
    ]
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
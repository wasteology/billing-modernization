{
  "vendor_name": "Ace Recycling & Disposal",
  "format_label": "ace_recycling",
  "routing_regex": "ACE\\s+Recycling\\s+&\\s+Disposal",
  "routing_flags": [],
  "routing_priority": 50,
  "is_active": true,
  "sample_md5": null,
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "INVOICE\\s*#\\s*(?P<invoice_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "DATE\\s+(?P<invoice_date>(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\s+\\d{1,2},?\\s+\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "ACCOUNT\\s*#\\s*(?P<account_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "INVOICE\\s+TOTAL\\s+\\$\\s*(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "DATE\\s+DESCRIPTION.*?TOTAL\\s*\\n(?P<body>.*?)INVOICE\\s+TOTAL",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": "body"
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "Site\\s+\\d+\\w*\\s*-\\s*[^-]+-\\s*(?P<service_address>[^\\n]+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_address": "service_address"}
    }
  ],
  "execution_plan": [
    "bill_total_parse"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "front load",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "frontload",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "roll off",
          "label": "ROLL_OFF"
        }
      ]
    },
    "equipment_size_extract": {
      "type": "regex_parse_multi",
      "source_field": "description",
      "pattern": "(?P<size_num>\\d+)\\s*(?P<size_unit>Yards?|Gal(?:lon)?s?)",
      "flags": [
        "IGNORECASE"
      ],
      "group_outputs": [
        {
          "group": "size_num",
          "output_field": "_size_num"
        },
        {
          "group": "size_unit",
          "output_field": "_size_unit",
          "map": {
            "Yard": "YD",
            "Yards": "YD",
            "Gallon": "GAL",
            "Gallons": "GAL",
            "Gal": "GAL"
          }
        }
      ]
    },
    "equipment_size_format": {
      "type": "concat_fields",
      "fields": [
        "_size_num",
        "_size_unit"
      ],
      "separator": " ",
      "output_field": "equipment_size"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycle",
          "label": "Recycling"
        },
        {
          "keywords": "trash",
          "label": "Trash"
        },
        {
          "keywords": "msw",
          "label": "MSW"
        }
      ]
    },
    "schedule_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "schedule",
      "rules": [
        {
          "keywords": "no activity",
          "label": "ON_CALL"
        },
        {
          "keywords": "each",
          "label": "ON_CALL"
        },
        {
          "keywords": "per ton",
          "label": "ON_CALL"
        }
      ]
    },
    "weight_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "pattern": "(\\d+\\.\\d+)\\s+\\$\\s*[\\d,]+\\.\\d{2}\\s+per\\s+ton",
      "output_field": "weight",
      "group": 1,
      "flags": [
        "IGNORECASE"
      ]
    },
    "charge_type_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "extra pick up",
          "label": "Extra"
        },
        {
          "keywords": "no activity",
          "label": "No Activity"
        },
        {
          "keywords": "monthly rent",
          "label": "Container Usage Charge"
        },
        {
          "keywords": "trip charge",
          "label": "Trip"
        },
        {
          "keywords": "haul charge",
          "label": "Haul"
        },
        {
          "keywords": "delivery charge",
          "label": "Delivery"
        },
        {
          "keywords": "relocate",
          "label": "Relocate"
        },
        {
          "keywords": "labor",
          "label": "Labor"
        },
        {
          "keywords": "disposal",
          "label": "Disposal"
        },
        {
          "keywords": "service",
          "label": "Pickup"
        }
      ]
    },
    "charge_code_normalize": {
      "type": "charge_normalize",
      "charge_type_field": "charge_type",
      "equipment_type_field": "equipment_type",
      "output_field": "charge_code",
      "equipment_class_map": {
        "FRONT_LOAD": "commercial",
        "COMPACTOR": "industrial",
        "ROLL_OFF": "industrial"
      },
      "charge_code_map": {
        "Pickup": {
          "commercial": "Monthly Service Commercial",
          "industrial": "Monthly Service Industrial"
        },
        "Container Usage Charge": {
          "commercial": "Monthly Rental Commercial",
          "industrial": "Monthly Rental Industrial"
        },
        "Delivery": {
          "commercial": "Delivery Commercial",
          "industrial": "Delivery Industrial"
        },
        "Disposal": "Disposal Charge",
        "Haul": "Empty & Return",
        "Trip": "Trip Charge",
        "Extra": "Extra Pick Up",
        "No Activity": "Inactivity Charge",
        "Relocate": "Empty & Return",
        "Labor": "Local Surcharge Commercial",
        "Fuel": "FUEL SURCHARGE"
      }
    },
    "parent_container_resolve": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "both",
      "skip_zero": false
    },
    "material_inherit": {
      "type": "parent_container",
      "charges_field": "_charges",
      "parent_key": "material",
      "inherit_fields": [
        "material"
      ],
      "direction": "both",
      "skip_zero": false
    },
    "renormalize_after_parent": {
      "type": "renormalize_codes",
      "charges_field": "_charges",
      "charge_type_field": "charge_type",
      "equipment_type_field": "equipment_type",
      "output_field": "charge_code",
      "equipment_class_map": {
        "FRONT_LOAD": "commercial",
        "COMPACTOR": "industrial",
        "ROLL_OFF": "industrial"
      },
      "charge_code_map": {
        "Pickup": {
          "commercial": "Monthly Service Commercial",
          "industrial": "Monthly Service Industrial"
        },
        "Container Usage Charge": {
          "commercial": "Monthly Rental Commercial",
          "industrial": "Monthly Rental Industrial"
        },
        "Delivery": {
          "commercial": "Delivery Commercial",
          "industrial": "Delivery Industrial"
        },
        "Disposal": "Disposal Charge",
        "Haul": "Empty & Return",
        "Trip": "Trip Charge",
        "Extra": "Extra Pick Up",
        "No Activity": "Inactivity Charge",
        "Relocate": "Empty & Return",
        "Labor": "Local Surcharge Commercial",
        "Fuel": "FUEL SURCHARGE"
      }
    }
  },
  "charge_pipeline": {
    "source_field": "_body",
    "line_join_config": {
      "new_line_pattern": "\\d{2}/\\d{2}/\\d{2}|Fuel\\s+Surcharge"
    },
    "body_strip": [
      {
        "pattern": "^Tax\\s+\\$.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^Site\\s+Total\\s+\\$.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^DATE\\s+DESCRIPTION.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*Continued.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^NOTES.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*ACE\\s+Recycling.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^\\s*Page\\s+\\d+.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*AMOUNT\\s+[\\d,]+\\.\\d{2}.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*acedisposal.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*paperless.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*QUICK\\s+PAY.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*PO\\s+Box.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*ACCOUNT\\s*#.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*INVOICE\\s*#.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*Salt\\s+Lake.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*For\\s+Invoice\\s+Inquire.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^[A-Za-z].*\\.$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^\\*.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^(?!\\d{2}/\\d{2}/\\d{2}).*\\d+,\\d{3}\\.\\d{2}.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^[\\W\\s]*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      }
    ],
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{2})",
      "date_format": "{0}",
      "require_date": true
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total",
      "desc_extract_mode": "after_date",
      "weight_pattern": "(\\d+\\.?\\d*)\\s+\\$\\s*[\\d,]+\\.\\d{2}\\s+per\\s+ton"
    },
    "special_lines": [
      {
        "pattern": "Fuel\\s+Surcharge",
        "fields": {
          "charge_type": "Fuel",
          "description": "Fuel Surcharge"
        }
      }
    ],
    "skip_patterns": [],
    "per_charge_transforms": [
      "equipment_detect",
      "equipment_size_extract",
      "equipment_size_format",
      "material_detect",
      "schedule_detect",
      "charge_type_detect",
      "charge_code_normalize"
    ],
    "post_processing": [
      "parent_container_resolve",
      "material_inherit",
      "renormalize_after_parent"
    ]
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  },
  "notes": "Ace Recycling & Disposal. 100 invoices. 21 multi-invoice PDFs (only first invoice extracted per OCR record). Flat mode with line_join for material continuation lines."
}
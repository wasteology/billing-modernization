{
  "format_label": "veit_disposal",
  "vendor_name": "Veit Disposal Systems",
  "routing_regex": "Veit\\s+Disposal\\s+Systems",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "INVOICE\\s+NO\\.\\s+(?P<invoice_number>VM\\s*\\d{10})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "CUSTOMER\\s+NO\\.\\s+(?P<account_number>\\d{5})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "INVOICE\\s+DATE\\s+(?P<invoice_date>[A-Za-z]{3}-\\d{2}-\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "TOTAL\\s+INVOICE\\s+\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "Serv\\s+#\\d+(.*)TOTAL\\s+INVOICE",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "Northru?p\\s+Grumman\\s*\\n(?P<service_address>[^\\n]+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_address": "service_address"}
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%b-%d-%y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        }
      ],
      "default": "ROLL_OFF"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycle",
          "label": "RECYCLING"
        },
        {
          "keywords": "recycling",
          "label": "RECYCLING"
        },
        {
          "keywords": "const debris",
          "label": "C&D"
        },
        {
          "keywords": "construction",
          "label": "C&D"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        },
        {
          "keywords": "organic",
          "label": "ORGANICS"
        }
      ],
      "default": "MSW"
    },
    "size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "(\\d+\\.?\\d*\\s*[Yy][Dd])",
      "flags": [
        "IGNORECASE"
      ]
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "rental",
          "label": "Container Rental"
        },
        {
          "keywords": "delivery",
          "label": "Haul"
        },
        {
          "keywords": "pull",
          "label": "Haul"
        },
        {
          "keywords": "exchange",
          "label": "Haul"
        },
        {
          "keywords": "haul",
          "label": "Haul"
        },
        {
          "keywords": "disposal",
          "label": "Disposal"
        },
        {
          "keywords": "const debris",
          "label": "Disposal"
        },
        {
          "keywords": "fuel",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "surcharge",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "environmental",
          "label": "Environmental Surcharge"
        }
      ],
      "default": "Scheduled Service"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "rental",
          "label": "RENTAL"
        },
        {
          "keywords": "delivery",
          "label": "ON_CALL"
        },
        {
          "keywords": "pull",
          "label": "ON_CALL"
        },
        {
          "keywords": "exchange",
          "label": "ON_CALL"
        },
        {
          "keywords": "haul",
          "label": "ON_CALL"
        },
        {
          "keywords": "disposal",
          "label": "ON_CALL"
        },
        {
          "keywords": "const debris",
          "label": "ON_CALL"
        },
        {
          "keywords": "fuel",
          "label": "SURCHARGE"
        },
        {
          "keywords": "surcharge",
          "label": "SURCHARGE"
        },
        {
          "keywords": "environmental",
          "label": "SURCHARGE"
        }
      ],
      "default": "RECURRING"
    },
    "parent_inherit": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "both"
    },
    "schedule_oncall": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "rules": [
        {
          "keywords": "roll_off",
          "label": "ON_CALL"
        },
        {
          "keywords": "compactor",
          "label": "ON_CALL"
        }
      ]
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": "(\\d{2})\\s*-\\s*[A-Za-z]{3}",
      "date_format": "{0}",
      "require_date": true
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$([\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "skip_patterns": [
      "^\\s*W/O",
      "^\\s*Bill\\s+of",
      "^\\s*Carrier",
      "^\\s*PO\\d",
      "^\\s*Serv\\s+#",
      "^\\s*\\d{2}[A-Za-z]{3}\\d{2}-",
      "^\\s*$"
    ],
    "per_charge_transforms": [
      "equipment_detect",
      "schedule_oncall",
      "material_detect",
      "size_extract",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": [
      "parent_inherit"
    ]
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
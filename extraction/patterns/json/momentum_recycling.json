{
  "format_label": "momentum_recycling",
  "vendor_name": "Momentum Recycling",
  "routing_regex": "Momentum\\s+Recycling",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "Invoice\\s+No:\\s+(?P<invoice_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "(?:I|i)nvoice\\s+Date:\\s+(?P<invoice_date>\\d{1,2}/\\d{1,2}/\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "Invoice\\s+Amount:\\s+\\$(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "bill_total_alt",
      "method": "search",
      "pattern": "^Total:\\s+\\$(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE",
        "MULTILINE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      },
      "skip_if_set": [
        "bill_total"
      ]
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "(?P<_addr_street>\\d+\\s+S\\s+Miss[li]+e?\\s+W[ae]y)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "_addr_street": "_addr_street"
      }
    },
    {
      "name": "service_city",
      "method": "search",
      "pattern": "(?P<_addr_city_state>Roy,\\s*UT\\s+\\d{5})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "_addr_city_state": "_addr_city_state"
      }
    },
    {
      "name": "body",
      "method": "body_extract_all",
      "pattern": "(?:Product/Service\\s+Quantity\\s+Unit\\s+Price\\s+Total|Quantity\\s+Unit\\s+Price\\s+Total)\\s*\\n(.*?)(?:Thank\\s+you|Subtotal|Invoice\\s+Amount|$)",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format",
    "addr_concat"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%Y",
        "%-m/%-d/%Y"
      ]
    },
    "date_service": {
      "type": "date_parse",
      "field": "service_date",
      "formats": [
        "%m/%d/%Y",
        "%-m/%-d/%Y"
      ]
    },
    "addr_concat": {
      "type": "concat_fields",
      "fields": ["_addr_street", "_addr_city_state"],
      "separator": ", ",
      "output_field": "service_address"
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "cart",
          "label": "CART"
        },
        {
          "keywords": "pod",
          "label": "CART"
        }
      ],
      "default": "CART"
    },
    "equipment_size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "(\\d+)\\s*Gallon",
      "group": 1
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "glass",
          "label": "GLASS"
        },
        {
          "keywords": "food waste",
          "label": "ORGANICS"
        }
      ],
      "default": "RECYCLING"
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "fuel surcharge",
          "label": "FUEL SURCHARGE"
        }
      ],
      "default": "Monthly Service Commercial"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "fuel",
          "label": "SURCHARGE"
        }
      ],
      "default": "RECURRING"
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": "(\\d{1,2}/\\d{1,2}/\\d{4})",
      "date_format": "{0}",
      "require_date": true
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$([\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "line_join_config": {
      "new_line_pattern": "^\\d{1,2}/\\d{1,2}/\\d{4}"
    },
    "skip_patterns": [
      "^\\s*$",
      "^Fuel\\s+Surcharge$",
      "^Recycling\\s+Collection",
      "^\\d+\\s+Gallon\\s+Cart",
      "^Glass\\s+Pod",
      "^Container$",
      "^ontainer$",
      "^Additional\\s+Container$",
      "^1st\\s+Container$"
    ],
    "per_charge_transforms": [
      "date_service",
      "equipment_detect",
      "equipment_size_extract",
      "material_detect",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": []
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
{
  "vendor_name": "Athens Services",
  "format_label": "athens",
  "routing_regex": "Athens\\s+Services",
  "routing_flags": [
    "IGNORECASE"
  ],
  "routing_priority": 50,
  "is_active": true,
  "sample_md5": null,
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "INVOICE\\s+NUMBER\\s+(?P<invoice_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "INVOICE\\s+DATE\\s+(?P<invoice_date>\\d{2}/\\d{2}/\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "ACCOUNT\\s+(?P<account_number>[A-Z]{2}-\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "CURRENT\\s+CHARGES\\s+\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "Date\\s+Description\\s+Quantity\\s+Amount\\s*\\n(?P<body>.*)",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": "body"
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "SERVICE\\s+ADDRESS\\s+(?P<service_address>[^\\n]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "service_address": "service_address"
      }
    }
  ],
  "execution_plan": [
    "bill_total_parse"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "rolloff",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "r/o",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "rolltop",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "bin",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "sweeper",
          "label": "OTHER"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "equipment_size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "pattern": "(\\d+)\\s*YD",
      "output_field": "equipment_size",
      "group": 1,
      "flags": [
        "IGNORECASE"
      ],
      "transform": "{0} YD"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "c&d",
          "label": "C&D"
        },
        {
          "keywords": "organics",
          "label": "Organics"
        },
        {
          "keywords": "organic",
          "label": "Organics"
        },
        {
          "keywords": "food",
          "label": "Organics"
        },
        {
          "keywords": "c/b",
          "label": "Cardboard"
        },
        {
          "keywords": "cardboard",
          "label": "Cardboard"
        },
        {
          "keywords": "recy",
          "label": "Recycling"
        },
        {
          "keywords": "wood",
          "label": "Wood"
        },
        {
          "keywords": "green waste",
          "label": "Green Waste"
        },
        {
          "keywords": "trash",
          "label": "Trash"
        },
        {
          "keywords": "msw",
          "label": "MSW"
        }
      ]
    },
    "schedule_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "schedule",
      "rules": [
        {
          "keywords": "p/u: 6",
          "label": "Weekly x6"
        },
        {
          "keywords": "p/u: 5",
          "label": "Weekly x5"
        },
        {
          "keywords": "p/u: 4",
          "label": "Weekly x4"
        },
        {
          "keywords": "p/u: 3",
          "label": "Weekly x3"
        },
        {
          "keywords": "p/u: 2",
          "label": "Weekly x2"
        },
        {
          "keywords": "p/u:",
          "label": "Weekly x1"
        }
      ],
      "default": null
    },
    "weight_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "pattern": "TKT#\\s*\\d+\\s+(\\d+\\.\\d+)",
      "output_field": "weight",
      "group": 1,
      "flags": [
        "IGNORECASE"
      ]
    },
    "charge_type_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "disposal fee",
          "label": "Disposal"
        },
        {
          "keywords": "dump",
          "label": "Haul"
        },
        {
          "keywords": "bring in",
          "label": "Haul"
        },
        {
          "keywords": "del",
          "label": "Delivery"
        },
        {
          "keywords": "sweeper",
          "label": "Pickup"
        },
        {
          "keywords": "bin",
          "label": "Pickup"
        },
        {
          "keywords": "rolloff",
          "label": "Haul"
        },
        {
          "keywords": "r/o",
          "label": "Haul"
        }
      ],
      "default": "Pickup"
    },
    "charge_code_normalize": {
      "type": "charge_normalize",
      "charge_type_field": "charge_type",
      "equipment_type_field": "equipment_type",
      "output_field": "charge_code",
      "equipment_class_map": {
        "FRONT_LOAD": "commercial",
        "ROLL_OFF": "industrial",
        "OTHER": "commercial"
      },
      "charge_code_map": {
        "Pickup": {
          "commercial": "Monthly Service Commercial",
          "industrial": "Monthly Service Industrial"
        },
        "Disposal": "Disposal Charge",
        "Haul": "Empty & Return",
        "Delivery": {
          "commercial": "Delivery Commercial",
          "industrial": "Delivery Industrial"
        }
      }
    },
    "material_inherit": {
      "type": "parent_container",
      "charges_field": "_charges",
      "parent_key": "material",
      "inherit_fields": [
        "material"
      ],
      "direction": "both",
      "skip_zero": false
    }
  },
  "charge_pipeline": {
    "source_field": "_body",
    "body_strip": [
      {
        "pattern": "^.*\\bPMT\\b.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*\\bPO#\\b.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*WORK\\s+ORDER#.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*SUB\\s+ACCT:.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*SERVICES$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*PAYMENTS\\s+RECEIVED.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*Go\\s+Paperless.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*athensservices.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*AutoPay.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*Simplify.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*Enroll.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*IMPORTANT\\s+MESSAGES.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*ONLINE.*COPY.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*\\(cont\\.\\).*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*Date\\s+Description\\s+Quantity\\s+Amount.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*THIS\\s+INVOICE\\s+IS\\s+A\\s+COPY.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*DOES\\s+NOT\\s+INCLUDE.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*0\\s*-\\s*30\\s+Days.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*TOTAL\\s+AMOUNT\\s+DUE.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*ACCOUNT\\s+SUMMARY.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*INVOICE\\s+NUMBER.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*INVOICE\\s+DATE.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*DUE\\s+DATE.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*CURRENT\\s+CHARGES.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*BILLING\\s+PERIOD.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*SERVICE\\s+NAME.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*SERVICE\\s+ADDRESS.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*Athens\\s+Services.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*Waste\\s+Collection.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*ACCESS$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*NUMBER\\s+CODE.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*ACCOUNT\\s+[A-Z]{2}-\\d+.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*888-336-6100.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*Now!.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*never\\s+miss.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*convenient.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*fast,\\s+easy.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^[\\W\\s]*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      }
    ],
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{4})",
      "date_format": "{0}",
      "require_date": true
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total",
      "desc_extract_mode": "after_date",
      "weight_pattern": "TKT#\\s*\\d+\\s+(\\d+\\.\\d+)"
    },
    "skip_patterns": [],
    "per_charge_transforms": [
      "equipment_detect",
      "equipment_size_extract",
      "material_detect",
      "schedule_detect",
      "charge_type_detect",
      "charge_code_normalize"
    ],
    "post_processing": [
      "material_inherit"
    ]
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "charge_type",
      "weight",
      "weight_unit"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  },
  "notes": "Athens Services. 56 invoices. Flat mode. BIN = front load recurring (# P/U: N = weekly frequency). ROLLOFF/R/O = roll-off on-call. DISPOSAL FEE has weight via TKT# line. Multi-page invoices with sub-accounts."
}
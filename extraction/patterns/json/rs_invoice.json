{
  "vendor_name": "Republic Services",
  "format_label": "rs_invoice",
  "routing_regex": "REPUBLIC.{0,3}SERVICES|RepublicServices",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "routing_priority": 50,
  "is_active": true,
  "sample_md5": null,
  "extraction_stages": [
    {
      "name": "account_number",
      "method": "search",
      "pattern": "Account\\s+Number\\s+(?P<account_number>3-\\d{4}-\\d{7})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "Invoice\\s+Number\\s+(?P<invoice_number>\\d{4}-\\d{9,12})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "(?:Invoice\\s+Date|Payment\\s+Due\\s+Date)\\s+(?P<invoice_date>\\w+\\s+\\d{1,2},?\\s+\\d{4})",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "C\\w*\\s*Invoice\\s+Charges\\W*\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "CURRENT\\s+INVOICE\\s+CHARGES\\s*\\n(?:Description\\s+Reference[^\\n]*\\n)?(.+)CURRENT\\s+INVOICE\\s+CHARGES",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": 1
    },
    {
      "name": "body_ocr_variant",
      "method": "body_extract",
      "pattern": "CURRENT\\s*INVOICE\\s+CHARGES(?![^\\n]*\\$)[^\\n]*\\n(?:Description[^\\n]*Reference[^\\n]*\\n)?(.+)CURRENT\\s*INVOICE\\s+CHARGES",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": 1,
      "skip_if_set": [
        "_body"
      ]
    },
    {
      "name": "body_fallback",
      "method": "body_extract",
      "pattern": "Description[^\\n]*Reference[^\\n]*\\n(.+?)(?:Total\\s+Amount\\s+Due|Past\\s+Due\\b|30\\s+Days\\s+60\\s+Days|Please\\s+Return|UNDERSTANDING)",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": 1,
      "skip_if_set": [
        "_body"
      ]
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "Northrop\\s+Grumman[^\\d\\n]*(?P<service_address>\\d+[^\\n]+?)(?:\\s+PO\\s+\\w|\\s+CSA\\s|\\s*$)",
      "flags": [
        "IGNORECASE",
        "MULTILINE"
      ],
      "field_map": {
        "service_address": "service_address"
      }
    },
    {
      "name": "service_address_atk",
      "method": "search",
      "pattern": "(?:Orbital\\s+)?Atk\\b[^\\d\\n]*(?P<service_address>\\d+[^\\n]+?)(?:\\s+PO\\s+\\w|\\s+CSA\\s|\\s*$)",
      "flags": [
        "IGNORECASE",
        "MULTILINE"
      ],
      "field_map": {
        "service_address": "service_address"
      },
      "skip_if_set": ["service_address"]
    },
    {
      "name": "service_address_subsidiary",
      "method": "search",
      "pattern": "Cutting\\s+Edge\\s+Optronic[^\\d\\n]*(?P<service_address>\\d+[^\\n]+?)(?:\\s+PO\\s+\\w|\\s+CSA\\s|\\s*$)",
      "flags": [
        "IGNORECASE",
        "MULTILINE"
      ],
      "field_map": {
        "service_address": "service_address"
      },
      "skip_if_set": ["service_address"]
    }
  ],
  "execution_plan": [
    "parse_bill_total",
    "date_fallback",
    "strip_mid_stub",
    "strip_stub_boundary"
  ],
  "transform_rules": {
    "parse_bill_total": {
      "type": "currency_parse",
      "field": "bill_total"
    },
    "date_fallback": {
      "type": "regex_capture",
      "source_field": "_raw_text",
      "pattern": "Past\\s+Due\\s+on\\s+(\\d{2}/\\d{2}/\\d{2,4})",
      "output_field": "invoice_date",
      "group": 1,
      "skip_if_set": true
    },
    "strip_mid_stub": {
      "type": "regex_strip",
      "field": "_body",
      "pattern": "\\n\\s*(?:30\\s+Days\\s+60\\s+Days|Please\\s+Return\\s+This|UNDERSTANDING\\s+(?:YOUR|OUR)\\s+(?:BILL|RATES))[\\s\\S]*?(?=\\n\\s*(?:CURRENT\\s+INVOICE\\s+CHARGES|Description\\s+Reference))",
      "flags": [
        "IGNORECASE"
      ]
    },
    "strip_stub_boundary": {
      "type": "regex_strip",
      "field": "_body",
      "pattern": "\\n\\s*(?:30\\s+Days\\s+60\\s+Days|Past\\s+Due|Total\\s+Amount\\s+Due|Please\\s+Return\\s+This|UNDERSTANDING\\s+(?:YOUR|OUR)\\s+(?:BILL|RATES)|Simple\\s+account\\s+access|LS\\s+(?:=?PUBL|REPUBLIC))[\\s\\S]*?(?=\\n\\s*(?:CURRENT\\s+INVOICE\\s+CHARGES|Description\\s+Reference)|\\Z)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "equip_classify": {
      "type": "keyword_classify",
      "source_field": "_equip_desc",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "front load",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "comp",
          "label": "COMPACTOR"
        },
        {
          "keywords": "cart",
          "label": "CART"
        }
      ]
    },
    "equip_oncall_check": {
      "type": "keyword_classify",
      "source_field": "_schedule_raw",
      "output_field": "equipment_type",
      "skip_if_set": true,
      "rules": [
        {
          "keywords": "on call",
          "label": "OPEN_TOP"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "material_classify_svc": {
      "type": "keyword_classify",
      "source_field": "_equip_desc",
      "output_field": "material",
      "rules": [
        {
          "keywords": "organics",
          "label": "Organics"
        },
        {
          "keywords": "organic",
          "label": "Organics"
        },
        {
          "keywords": "cardboard",
          "label": "Cardboard"
        },
        {
          "keywords": "corrugated",
          "label": "Cardboard"
        },
        {
          "keywords": "occ",
          "label": "Cardboard"
        },
        {
          "keywords": "single stream",
          "label": "Single Stream"
        },
        {
          "keywords": "recycle",
          "label": "Recycling"
        },
        {
          "keywords": "recycling",
          "label": "Recycling"
        },
        {
          "keywords": "waste",
          "label": "Trash"
        },
        {
          "keywords": "front load",
          "label": "Trash"
        },
        {
          "keywords": "wood",
          "label": "Wood"
        },
        {
          "keywords": "c&d",
          "label": "C&D"
        }
      ]
    },
    "material_classify_schedule": {
      "type": "keyword_classify",
      "source_field": "_schedule_raw",
      "output_field": "material",
      "rules": [
        {
          "keywords": "organics",
          "label": "Organics"
        },
        {
          "keywords": "organic",
          "label": "Organics"
        },
        {
          "keywords": "corrugated",
          "label": "Cardboard"
        },
        {
          "keywords": "cardboard",
          "label": "Cardboard"
        },
        {
          "keywords": "single stream",
          "label": "Single Stream"
        }
      ]
    },
    "schedule_per_n": {
      "type": "regex_parse_multi",
      "source_field": "_schedule_raw",
      "pattern": "(?P<lifts>\\d+)\\s+Lifts?\\s+Per\\s+(?P<per_n>[2-9]\\d*)\\s+(?P<freq>Week|Month|Day)",
      "flags": [
        "IGNORECASE"
      ],
      "group_outputs": [
        {
          "group": "lifts",
          "output_field": "schedule",
          "format": "Every {per_n} {freq}s x{value}"
        },
        {
          "group": "per_n",
          "output_field": "_per_n"
        },
        {
          "group": "freq",
          "output_field": "_sched_freq"
        }
      ]
    },
    "schedule_extract": {
      "type": "regex_parse_multi",
      "source_field": "_schedule_raw",
      "pattern": "(?P<lifts>\\d+)\\s+Lifts?\\s+Per\\s+(?P<freq>Week|Month|Day)",
      "flags": [
        "IGNORECASE"
      ],
      "skip_if_set": "schedule",
      "group_outputs": [
        {
          "group": "lifts",
          "output_field": "schedule",
          "format": "{freq}ly x{value}"
        },
        {
          "group": "freq",
          "output_field": "_sched_freq"
        }
      ]
    },
    "schedule_oncall": {
      "type": "keyword_classify",
      "source_field": "_schedule_raw",
      "output_field": "schedule",
      "skip_if_set": true,
      "rules": [
        {
          "keywords": "on call",
          "label": "On Call"
        }
      ]
    },
    "size_split": {
      "type": "regex_capture",
      "source_field": "_size_num",
      "pattern": "(\\d+)$",
      "output_field": "_size_num",
      "group": 1
    },
    "unit_normalize": {
      "type": "lookup_map",
      "field": "_size_unit",
      "map": {
        "Yd": "YD",
        "Gal": "GAL"
      },
      "case_insensitive": true
    },
    "_build_equip_size": {
      "type": "concat_fields",
      "fields": [
        "_size_num",
        "_size_unit"
      ],
      "separator": " ",
      "output_field": "equipment_size"
    },
    "_set_desc_lower": {
      "type": "set_field",
      "source_field": "description",
      "output_field": "_desc_lower",
      "transform": "lower"
    },
    "date_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "pattern": "(\\d{2}/\\d{2}(?:-\\d{2}/\\d{2})?)",
      "output_field": "service_date",
      "group": 1
    },
    "material_classify_charge": {
      "type": "keyword_classify",
      "source_field": "_desc_lower",
      "output_field": "_line_material",
      "rules": [
        {
          "keywords": "organics",
          "label": "Organics"
        },
        {
          "keywords": "organic",
          "label": "Organics"
        },
        {
          "keywords": "corrugated cardboard",
          "label": "Cardboard"
        },
        {
          "keywords": "cardboard",
          "label": "Cardboard"
        },
        {
          "keywords": "single stream",
          "label": "Single Stream"
        },
        {
          "keywords": "recycling",
          "label": "Recycling"
        },
        {
          "keywords": "recycle",
          "label": "Recycling"
        },
        {
          "keywords": "wood",
          "label": "Wood"
        },
        {
          "keywords": "c&d",
          "label": "C&D"
        },
        {
          "keywords": "trash",
          "label": "Trash"
        },
        {
          "keywords": "waste",
          "label": "Trash"
        }
      ]
    },
    "_apply_line_material": {
      "type": "copy_if_not_null",
      "source_field": "_line_material",
      "target_field": "material"
    },
    "pickup_recurring": {
      "type": "regex_parse_multi",
      "source_field": "_desc_lower",
      "pattern": "pickup service.*\\d{2}/\\d{2}-\\d{2}/\\d{2}",
      "flags": [
        "IGNORECASE"
      ],
      "skip_if_set": "charge_type",
      "group_outputs": [],
      "set_on_match": {
        "charge_type": "Pickup"
      }
    },
    "pickup_haul": {
      "type": "regex_parse_multi",
      "source_field": "_desc_lower",
      "pattern": "pickup service",
      "flags": [
        "IGNORECASE"
      ],
      "skip_if_set": "charge_type",
      "group_outputs": [],
      "set_on_match": {
        "charge_type": "Haul"
      }
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "_desc_lower",
      "output_field": "charge_type",
      "skip_if_set": true,
      "rules": [
        {
          "keywords": "disposal",
          "label": "Disposal"
        },
        {
          "keywords": [
            "recycling",
            "processing"
          ],
          "label": "Recycling Processing"
        },
        {
          "keywords": "recycling service",
          "label": "Recycling Service"
        },
        {
          "keywords": [
            "organic",
            "processing"
          ],
          "label": "Organic Processing"
        },
        {
          "keywords": [
            "organic",
            "service"
          ],
          "label": "Organic Processing"
        },
        {
          "keywords": "rental",
          "label": "Rental"
        },
        {
          "keywords": "delivery",
          "label": "Delivery"
        },
        {
          "keywords": [
            "fuel",
            "environmental"
          ],
          "label": "Fuel Surcharge"
        },
        {
          "keywords": "fuel",
          "label": "Fuel Surcharge"
        },
        {
          "keywords": "environmental",
          "label": "Fuel Surcharge"
        },
        {
          "keywords": "administrative",
          "label": "Administrative Fee"
        },
        {
          "keywords": "ab939",
          "label": "Local Fee"
        },
        {
          "keywords": "franchise",
          "label": "Local Fee"
        },
        {
          "keywords": "container refresh",
          "label": "Container Refresh"
        },
        {
          "keywords": "late fee",
          "label": "Late Fee"
        },
        {
          "keywords": "overage",
          "label": "Overage"
        },
        {
          "keywords": "minimum lift",
          "label": "Minimum Lift Fee"
        },
        {
          "keywords": "non-scheduled",
          "label": "Non-Scheduled Service"
        },
        {
          "keywords": "non scheduled",
          "label": "Non-Scheduled Service"
        },
        {
          "keywords": "contaminated",
          "label": "Contaminated Materials"
        },
        {
          "keywords": "container removal",
          "label": "Container Removal"
        },
        {
          "keywords": "service attempt",
          "label": "Service Attempt"
        },
        {
          "keywords": [
            "total",
            "sales tax"
          ],
          "label": "Sales Tax"
        }
      ]
    },
    "charge_code_normalize": {
      "type": "charge_normalize",
      "charge_type_field": "charge_type",
      "equipment_type_field": "equipment_type",
      "output_field": "charge_code",
      "equipment_class_map": {
        "FRONT_LOAD": "commercial",
        "REAR_LOAD": "commercial",
        "CART": "commercial",
        "OPEN_TOP": "industrial",
        "COMPACTOR": "industrial"
      },
      "charge_code_map": {
        "Pickup": "Monthly Service Commercial",
        "Haul": "Empty & Return",
        "Disposal": "Disposal Charge",
        "Recycling Service": "Monthly Service Commercial",
        "Organic Processing": "Monthly Service Commercial",
        "Recycling Processing": "Disposal Charge",
        "Rental": {
          "commercial": "Monthly Rental Commercial",
          "industrial": "Monthly Rental Industrial"
        },
        "Delivery": {
          "commercial": "Delivery Commercial",
          "industrial": "Delivery Industrial"
        },
        "Fuel Surcharge": "Environmental Surcharge",
        "Administrative Fee": "Local Surcharge Commercial",
        "Local Fee": "Local Surcharge Commercial",
        "Container Refresh": "Miscellaneous",
        "Late Fee": "Vendor Late Fees",
        "Overage": "Overage",
        "Minimum Lift Fee": "Minimum Lift Fee",
        "Non-Scheduled Service": "Extra Pick Up",
        "Contaminated Materials": "Contaminated Load",
        "Container Removal": "Final Pick Up",
        "Service Attempt": "Trip Charge",
        "Sales Tax": "Tax Commercial"
      }
    },
    "dedup_fuel": {
      "type": "dedup_summary",
      "charges_field": "_charges",
      "summary_pattern": "^Total\\s+(Fuel|Environmental)",
      "detail_match_field": "charge_type"
    },
    "parent_container": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "backward",
      "skip_zero": true
    }
  },
  "charge_pipeline": {
    "source_field": "_body",
    "context_fields": [
      "equipment_type",
      "equipment_size",
      "material",
      "schedule"
    ],
    "body_strip": [],
    "service_line": {
      "pattern": "(?P<qty_containers>\\d+)\\s+(?P<equip_desc>(?:Waste|Recycle|Recycling|Ind\\s+Recycle\\s+Cont|Front\\s+Load|Fl\\s+Mixed\\s+Organics?|Organic)\\s*(?:Container|Compactor|Cart|Comp)?)\\s*(?P<size>\\d+(?:/\\d+)?)\\s*(?:Cu\\s+)?(?P<unit>Yd|Gal)\\w*,?\\s*(?P<schedule_raw>.+?)$",
      "flags": [
        "IGNORECASE",
        "MULTILINE"
      ],
      "field_map": {
        "equip_desc": "_equip_desc",
        "size": "_size_num",
        "unit": "_size_unit",
        "schedule_raw": "_schedule_raw"
      },
      "transforms": [
        "equip_classify",
        "equip_oncall_check",
        "material_classify_svc",
        "material_classify_schedule",
        "schedule_per_n",
        "schedule_extract",
        "schedule_oncall",
        "size_split",
        "unit_normalize",
        "_build_equip_size"
      ]
    },
    "skip_patterns": [
      "^Description\\s+Reference",
      "^Location\\s+Total",
      "^Receipt\\s+[Nn]umber",
      "(?i)URRENT\\s*INVOICE\\s*CHARGES",
      "(?i)Thank\\s+You",
      "(?i)^Page\\s+\\d+\\s+of\\s+\\d+",
      "(?i)^Account\\s+Number\\s+3-",
      "(?i)^Invoice\\s+Number\\s+\\d{4}-",
      "(?i)^Invoice\\s+Date\\s+\\w+",
      "(?i)Due\\s+by\\s+\\w+\\s+\\d",
      "(?i)Please\\s+Return",
      "(?i)Total\\s+Amount\\s+Due",
      "(?i)Past\\s+Due\\s+on",
      "(?i)30\\s+Days\\s+60\\s+Days",
      "(?i)Payment\\s+Due",
      "(?i)Remit\\s+To",
      "(?i)Return\\s+Service",
      "(?i)Simple\\s+account\\s+access",
      "(?i)UNDERSTANDING\\s+(?:YOUR|OUR)"
    ],
    "charge_detect": {},
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$?(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total",
      "weight_pattern": "([\\d.]+)\\s*Tons?"
    },
    "per_charge_transforms": [
      "date_extract",
      "_set_desc_lower",
      "pickup_recurring",
      "pickup_haul",
      "charge_type_classify",
      "charge_code_normalize"
    ],
    "post_processing": [
      "dedup_fuel",
      "parent_container"
    ]
  },
  "output_spec": {
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total",
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "qty",
      "unit_rate",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_total",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address",
      "qty",
      "unit_rate"
    ]
  }
}
  "charge_pipeline": {
    "source_field": "_body",
    "context_fields": [
      "equipment_type",
      "equipment_size",
      "material",
      "schedule"
    ],
    "body_strip": [],
    "service_line": {
      "pattern": "Serv\\s+#(?P<serv_num>\\d+)\\s+(?P<equip_desc>.+?)\\s+(?P<qty_containers>\\d+)\\s*-\\s*(?P<size>\\d+)(?P<unit>YD|GAL)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "equip_desc": "_equip_desc",
        "size": "_size_num",
        "unit": "_size_unit"
      },
      "transforms": [
        "equip_classify",
        "material_classify_svc",
        "schedule_classify",
        "_build_equip_size"
      ]
    },
    "skip_patterns": [
      "^\\(",
      "^(DATE|DESCRIPTION|REFERENCE|QTY|RATE|AMOUNT)"
    ],
    "charge_detect": {
      "date_pattern": "^(\\d{1,2})\\s*-\\s*(\\w{3})",
      "date_format": "{0}-{1}"
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$?([\\d,]+\\.\\d{2})",
      "wo_pattern": "W\\.?[O0]#?\\s*(\\d+)",
      "ref_pattern": "(\\d{2}-\\d{7})",
      "weight_pattern": "([\\d.]+)\\s*(?:Tons?|tons?)"
    },
    "per_charge_transforms": [
      "_set_desc_lower",
      "charge_type_classify",
      "material_classify_charge",
      "_apply_line_material",
      "charge_code_normalize",
      "schedule_default"
    ]
  },
  "output_spec": {
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "invoice_total",
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "invoice_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_total",
      "charge_code"
    ],
    "csv_columns": [
      "pdf_filename",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "invoice_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_total",
      "charge_code",
      "flag",
      "service_address"
    ]
  }

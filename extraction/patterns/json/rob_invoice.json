      "equipment_class_map": {
        "FRONT_LOAD": "commercial",
        "REAR_LOAD": "commercial",
        "CART": "commercial",
        "OPEN_TOP": "industrial",
        "COMPACTOR": "industrial"
      },
      "charge_code_map": {
        "Dump & Return": "Empty & Return",
        "Disposal": "Disposal Charge",
        "Container Service Fee": "Monthly Service Commercial",
        "Pickup": "Monthly Service Commercial",
        "Haul": "Empty & Return",

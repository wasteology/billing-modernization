{
  "vendor_name": "Robinson Waste Services",
  "format_label": "rob_invoice",
  "routing_regex": "OBINSON\\s+WASTE\\s+SERVICES",
  "routing_flags": [
    "IGNORECASE"
  ],
  "routing_priority": 50,
  "is_active": true,
  "sample_md5": null,
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "(?:INVOICE|VOICE)\\s+NO\\.?\\s+(?P<invoice_number>[A-Z]{0,3}\\d{7,10})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "DATE\\s+(?P<invoice_date>\\d{2}/\\d{2}/\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "ACCOUNT\\s+NO\\.?\\s+(?P<account_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "AMOUNT\\s+DUE:?\\s+\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "invoice_total",
      "method": "search",
      "pattern": "TOTAL\\s+\\$?(?P<invoice_total>[\\d,]+\\.\\d{2})\\s*\\n?\\s*AGE\\b",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_total": "invoice_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "THANK\\s+YOU!?\\s*\\n(.*?)(?:Your\\s+account|Cr\\w+\\s+card\\s+pay)",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": 1
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "Location[.:]\\s*(?P<service_address>[^\\n]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "service_address": "service_address"
      }
    }
  ],
  "execution_plan": [
    "parse_bill_total",
    "parse_invoice_total",
    "strip_page_breaks"
  ],
  "transform_rules": {
    "parse_bill_total": {
      "type": "currency_parse",
      "field": "bill_total"
    },
    "parse_invoice_total": {
      "type": "currency_parse",
      "field": "invoice_total"
    },
    "strip_page_breaks": {
      "type": "regex_strip",
      "field": "_body",
      "pattern": "INVOICE\\s*\\n\\s*TOTAL\\s*\\n.*?THANK\\s+YOU!?\\s*\\n",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ]
    },

    "_build_equip_size": {
      "type": "concat_fields",
      "fields": [
        "_size_num",
        "_size_unit"
      ],
      "separator": " ",
      "output_field": "equipment_size"
    },
    "_set_desc_lower": {
      "type": "set_field",
      "source_field": "description",
      "output_field": "_desc_lower",
      "transform": "lower"
    },
    "_apply_line_material": {
      "type": "copy_if_not_null",
      "source_field": "_line_material",
      "target_field": "material"
    },
    "schedule_default": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "rules": [],
      "skip_if_set": true
    }

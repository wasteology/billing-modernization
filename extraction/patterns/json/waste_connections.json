{
  "format_label": "waste_connections",
  "vendor_name": "Waste Connections",
  "routing_regex": "WASTE\\s+CONNECTIONS.*(?:ACCOUNT\\s+NO\\.|Customer\\s+No\\.)",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "INVOICE\\s+NO\\.\\s+(?P<invoice_number>\\d{5,}\\S*)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_number_alt",
      "method": "search",
      "pattern": "\\w+-\\d{2}-\\d{2}\\s+(?P<invoice_number>\\d{5,})\\s+#\\*",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      },
      "skip_if_set": [
        "invoice_number"
      ]
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "(?:ACCOUNT\\s+NO\\.|Customer\\s+No\\.:?)\\s*(?P<account_number>[\\d-]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "STATEMENT\\s+DATE\\s+(?P<invoice_date>\\d{2}/\\d{2}/\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "invoice_date_alt",
      "method": "search",
      "pattern": "Account\\s+(?P<invoice_date>\\w+-\\d{2}-\\d{2})\\s+\\d{4,}",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      },
      "skip_if_set": [
        "invoice_date"
      ]
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "Current\\s+Charges\\s+And\\s+Fees\\s+\\$?\\s*(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "bill_total_pay",
      "method": "search",
      "pattern": "PAY\\s+THIS\\s+AMOUNT.*?\\$\\s*(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "field_map": {
        "bill_total": "bill_total"
      },
      "skip_if_set": [
        "bill_total"
      ]
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "[_\\s]*Date[_\\s\u2014]+Description[,\\s]+A\\w+[^\\n]*\\n(.*)Current\\s+Charges\\s+And\\s+Fees",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    },
    {
      "name": "body_alt",
      "method": "body_extract_all",
      "pattern": "Customer\\s+No\\..*?\\n(.*?)(?:Total\\s+Balance|PAY\\s+THIS\\s+AMOUNT|Invoice\\s+Date\\s+Invoice)",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1,
      "skip_if_set": [
        "body"
      ]
    },
    {
      "name": "body_invoice_stmt",
      "method": "body_extract",
      "pattern": "Date\\s+Description\\s+Amount[^\\n]*\\n(.*?)(?:Invoice\\s+Total|Account\\s+Balance|PAY\\s+THIS\\s+AMOUNT)",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1,
      "skip_if_set": [
        "body"
      ]
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "\\(\\d+\\)\\s*NORTHROP[^\\n]*\\n(?P<service_address>[^\\n]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "service_address": "service_address"
      }
    },
    {
      "name": "service_address_acct",
      "method": "search",
      "pattern": "Service\\s+Location[^\\n]+\\nAcct\\s+#\\S+\\s+(?P<service_address>\\d+[^\\n]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "service_address": "service_address"
      },
      "skip_if_set": ["service_address"]
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%y"
      ]
    },
    "date_service": {
      "type": "date_parse",
      "field": "service_date",
      "formats": [
        "%m/%d/%y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "roll off",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "ro ",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "dump",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "open top",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "rental",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "cart",
          "label": "CART"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycl",
          "label": "RECYCLING"
        },
        {
          "keywords": "single stream",
          "label": "RECYCLING"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        },
        {
          "keywords": "demolition",
          "label": "C&D"
        },
        {
          "keywords": "c&d",
          "label": "C&D"
        },
        {
          "keywords": "concrete",
          "label": "C&D"
        },
        {
          "keywords": "organic",
          "label": "ORGANICS"
        }
      ],
      "default": "MSW"
    },
    "size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "([\\d.]+\\s*YD)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": " tn",
          "label": "Disposal Charge"
        },
        {
          "keywords": "disposal",
          "label": "Disposal Charge"
        },
        {
          "keywords": "fuel",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "surcharge",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "environmental compliance",
          "label": "Environmental Surcharge"
        },
        {
          "keywords": "rent",
          "label": "Container Rental"
        },
        {
          "keywords": "lease",
          "label": "Container Rental"
        },
        {
          "keywords": "administrative",
          "label": "Administrative Fee"
        },
        {
          "keywords": "finance",
          "label": "Late Fee"
        },
        {
          "keywords": "haul",
          "label": "Haul"
        },
        {
          "keywords": "dump",
          "label": "Haul"
        }
      ],
      "default": "Scheduled Service"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "rent",
          "label": "RENTAL"
        },
        {
          "keywords": "lease",
          "label": "RENTAL"
        },
        {
          "keywords": "haul",
          "label": "ON_CALL"
        },
        {
          "keywords": "dump",
          "label": "ON_CALL"
        },
        {
          "keywords": "disposal",
          "label": "ON_CALL"
        },
        {
          "keywords": "fuel",
          "label": "SURCHARGE"
        },
        {
          "keywords": "surcharge",
          "label": "SURCHARGE"
        },
        {
          "keywords": "finance",
          "label": "FEE"
        },
        {
          "keywords": "administrative",
          "label": "FEE"
        }
      ],
      "default": "RECURRING"
    },
    "parent_inherit": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "both"
    },
    "schedule_oncall": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "rules": [
        {
          "keywords": "roll_off",
          "label": "ON_CALL"
        },
        {
          "keywords": "compactor",
          "label": "ON_CALL"
        }
      ]
    },
    "schedule_monthly": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "skip_if_set": true,
      "rules": []
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": "(\\d{1,2}/\\d{2}/\\d{2})",
      "date_format": "{0}",
      "require_date": false
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$\\s*(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "skip_patterns": [
      "^\\s*\\d{7}\\s+PO#",
      "^\\s*\\d{2}/\\d{2}/\\d{2}-\\d{2}/\\d{2}/\\d{2}",
      "^\\s*Service\\s+Location",
      "^\\s*Acct\\s+#",
      "^\\s*PO#",
      "^\\s*W/O\\s+#",
      "^\\s*Total\\s+Due",
      "Previous\\s+Balance",
      "Payment",
      "Total\\s+Payments",
      "Credit",
      "PAY\\s+THIS\\s+AMOUNT",
      "DUE\\s+UPON\\s+RECEIPT",
      "REMIT\\s+TO",
      "(?i)waste\\s+connections",
      "(?i)hauling\\s+page",
      "(?i)^\\s*code\\s+description",
      "(?i)^\\s*date\\s*$",
      "INVOICE\\s+DATE",
      "CUSTOMER\\s+#",
      "(?i)^\\s*\\d{4,}\\s*$",
      "(?i)Site\\s+Total",
      "(?i)Invoice\\s+Total",
      "(?i)Account\\s+Balance",
      "(?i)Acct\\s+#\\d",
      "(?i)Service\\s+(?:From|Through)",
      "^\\s*$"
    ],
    "per_charge_transforms": [
      "date_service",
      "equipment_detect",
      "schedule_monthly",
      "schedule_oncall",
      "material_detect",
      "size_extract",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": [
      "parent_inherit"
    ]
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
{
  "vendor_name": "Modern Disposal",
  "format_label": "modern_disposal",
  "routing_regex": "Modern\\s+(Disposal\\s+Services|Recycling|Portable\\s+Toilets),\\s+Inc\\.",
  "routing_flags": [
    "IGNORECASE"
  ],
  "routing_priority": 50,
  "is_active": true,
  "sample_md5": null,
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "Invoice\\s+Number:\\s*(?P<invoice_number>\\d{7,10})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "Date:\\s*(?P<invoice_date>\\d{2}/\\d{2}/\\d{2,4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "Service\\s+Number:\\s*(?P<account_number>\\d+\\s*-\\s*\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "Invoice\\s+Total:\\s*\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "(?:_?DateofSe\\w+|\\[DateofSe\\w+|Date\\s+of\\s+Service:).*?\\n(?P<body>.*?)(?:Overfilled|Effective|Please\\s+call|Sales\\s+Tax:|Invoice\\s+Total:)",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": "body"
    },
    {
      "name": "service_street",
      "method": "search",
      "pattern": "HARMONICS\\s+(?P<service_street>\\d+\\s+[^\\n]+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_street": "service_street"}
    },
    {
      "name": "service_city",
      "method": "search",
      "pattern": "HARMONICS\\s+\\d+[^\\n]+\\n[^\\n]+(?P<service_city>[A-Z][A-Z0-9 ]+,\\s*[A-Z]{2}\\s+[\\d-]+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_city": "service_city"}
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format",
    "addr_concat"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%y",
        "%m/%d/%Y"
      ]
    },
    "addr_concat": {
      "type": "concat_fields",
      "fields": ["service_street", "service_city"],
      "separator": ", ",
      "output_field": "service_address",
      "skip_empty": true
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "environmental regulatory fee",
          "label": "Environmental Surcharge"
        },
        {
          "keywords": "fuel surcharge",
          "label": "FUEL SURCHARGE"
        },
        {
          "keywords": "recycling processing fee",
          "label": "Local Surcharge Commercial"
        },
        {
          "keywords": "hauling charge",
          "label": "Empty & Return"
        },
        {
          "keywords": "dc trash",
          "label": "Disposal Charge"
        },
        {
          "keywords": "additional pickup",
          "label": "Extra Pick Up"
        },
        {
          "keywords": "container rental",
          "label": "Monthly Rental Commercial"
        },
        {
          "keywords": "grease trap",
          "label": "Monthly Service Commercial"
        },
        {
          "keywords": "toter",
          "label": "Monthly Service Commercial"
        },
        {
          "keywords": "frontlift",
          "label": "Monthly Service Commercial"
        },
        {
          "keywords": "front lift",
          "label": "Monthly Service Commercial"
        },
        {
          "keywords": "rear load",
          "label": "Monthly Service Commercial"
        },
        {
          "keywords": "wo#",
          "label": "Empty & Return"
        }
      ],
      "default": "Monthly Service Commercial"
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "roll off",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "frontlift",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "front lift",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "rear load",
          "label": "REAR_LOAD"
        },
        {
          "keywords": "toter",
          "label": "CART"
        },
        {
          "keywords": "gallon toter",
          "label": "CART"
        },
        {
          "keywords": "grease trap",
          "label": "OTHER"
        },
        {
          "keywords": "container rental",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "wo#",
          "label": "ROLL_OFF"
        }
      ]
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycl",
          "label": "RECYCLING"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        },
        {
          "keywords": "trash",
          "label": "TRASH"
        },
        {
          "keywords": "msw",
          "label": "MSW"
        },
        {
          "keywords": "grease",
          "label": "GREASE"
        },
        {
          "keywords": "wo#",
          "label": "TRASH"
        },
        {
          "keywords": "disposal",
          "label": "TRASH"
        }
      ]
    },
    "schedule_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "schedule",
      "rules": [
        {
          "keywords": [
            "every 2 weeks"
          ],
          "label": "Biweekly"
        },
        {
          "keywords": [
            "every other week"
          ],
          "label": "Biweekly"
        },
        {
          "keywords": "weekly",
          "label": "Weekly x1"
        }
      ],
      "default": null
    },
    "equipment_size_extract": {
      "type": "regex_parse_multi",
      "source_field": "description",
      "pattern": "(?P<size_num>\\d+)\\s*(?P<size_unit>CY|Gallon)",
      "flags": [
        "IGNORECASE"
      ],
      "group_outputs": [
        {
          "group": "size_num",
          "output_field": "_size_num"
        },
        {
          "group": "size_unit",
          "output_field": "_size_unit",
          "map": {
            "CY": "YD",
            "cy": "YD",
            "Gallon": "GAL",
            "gallon": "GAL"
          }
        }
      ]
    },
    "equipment_size_format": {
      "type": "concat_fields",
      "fields": [
        "_size_num",
        "_size_unit"
      ],
      "separator": " ",
      "output_field": "equipment_size"
    },
    "surcharge_inherit": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "both",
      "skip_zero": false
    }
  },
  "charge_pipeline": {
    "mode": "flat",
    "source_field": "_body",
    "skip_patterns": [
      "^\\s*$",
      "Overfilled",
      "Please\\s+call",
      "Effective\\s+with",
      "^\\d+\\.?\\d*\\s+-\\s+"
    ],
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{2,4})",
      "date_format": "{0}"
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total",
      "weight_pattern": "(\\d+\\.\\d+)\\s*-\\s*DC\\s"
    },
    "per_charge_transforms": [
      "charge_code_classify",
      "equipment_detect",
      "material_detect",
      "schedule_detect",
      "equipment_size_extract",
      "equipment_size_format"
    ],
    "post_processing": [
      "surcharge_inherit"
    ]
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
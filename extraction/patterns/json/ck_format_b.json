{
  "vendor_name": "Cockey's Enterprises",
  "format_label": "ck_format_b",
  "routing_regex": "COCKEY.S\\s+ENTERPRISES.*?INVOICE",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "routing_priority": 40,
  "is_active": true,
  "sample_md5": null,
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "Invoice\\s*#[:\\s]+(?P<invoice_number>\\d{6,7})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "Account\\s*#[:\\s]+(?P<account_number>[\\d]+-?[\\d]*)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "Invoice\\s+Date[:\\s]+(?P<invoice_date>[\\d/]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "invoice_date_fallback",
      "method": "search",
      "pattern": "\\bDATE\\s+(?P<invoice_date>\\w{1,2}\\s*\\w{1,3}\\s+\\d{1,2},?\\s+\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      },
      "skip_if_set": [
        "invoice_date"
      ]
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "Invoice\\s+Total\\s+(?P<bill_total>-?[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "For proper credit.*?portion[.!]?\\s*\\n(.*?)INVOICE\\s+TOTAL",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": 1
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "(?:Service\\s+)?Location:\\s*(?P<service_address>[^\\n]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "service_address": "service_address"
      }
    },
    {
      "name": "service_address_site",
      "method": "search",
      "pattern": "Site\\s+\\d+\\s*-\\s*NORTHROP\\s+GRUMMAN\\s*-\\s*(?:[^-\\n]+-\\s*){0,5}(?P<service_address>\\d+[^\\n]+?)(?:\\s+PO#|$)",
      "flags": [
        "IGNORECASE",
        "MULTILINE"
      ],
      "field_map": {
        "service_address": "service_address"
      },
      "skip_if_set": ["service_address"]
    }
  ],
  "execution_plan": [
    "parse_bill_total"
  ],
  "transform_rules": {
    "parse_bill_total": {
      "type": "currency_parse",
      "field": "bill_total"
    },
    "equip_classify": {
      "type": "keyword_classify",
      "source_field": "_desc_lower",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "fl-comm",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "flc-",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "closed box",
          "label": "OPEN_TOP"
        },
        {
          "keywords": "closedbox",
          "label": "OPEN_TOP"
        },
        {
          "keywords": "open top",
          "label": "OPEN_TOP"
        },
        {
          "keywords": "haul rate",
          "label": "OPEN_TOP"
        },
        {
          "keywords": "equip svc",
          "label": "OPEN_TOP"
        },
        {
          "keywords": "roll-off",
          "label": "OPEN_TOP"
        },
        {
          "keywords": "roll off",
          "label": "OPEN_TOP"
        },
        {
          "keywords": "ro",
          "label": "OPEN_TOP"
        }
      ]
    },
    "size_extract_fl": {
      "type": "regex_capture",
      "source_field": "_desc_lower",
      "pattern": "(\\d{2})\\s*yd",
      "output_field": "equipment_size",
      "group": 1
    },
    "size_format": {
      "type": "regex_parse_multi",
      "source_field": "equipment_size",
      "pattern": "^(\\d{2})$",
      "group_outputs": [
        {
          "group": 1,
          "output_field": "equipment_size",
          "suffix": "YD"
        }
      ]
    },
    "material_classify": {
      "type": "keyword_classify",
      "source_field": "_desc_lower",
      "output_field": "material",
      "rules": [
        {
          "keywords": "single stream",
          "label": "Single Stream"
        },
        {
          "keywords": "cardboard",
          "label": "Cardboard"
        },
        {
          "keywords": "paper",
          "label": "Paper"
        },
        {
          "keywords": "recycling",
          "label": "Recycling"
        },
        {
          "keywords": "rcy",
          "label": "Recycling"
        },
        {
          "keywords": "wood",
          "label": "Wood"
        },
        {
          "keywords": "metal",
          "label": "Scrap Metal"
        },
        {
          "keywords": "trash",
          "label": "Trash"
        }
      ],
      "default": "Trash"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "_desc_lower",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "single stream compactor",
          "label": "Disposal"
        },
        {
          "keywords": "disposal",
          "label": "Disposal"
        },
        {
          "keywords": "haul",
          "label": "Haul"
        },
        {
          "keywords": "delivery",
          "label": "Delivery"
        },
        {
          "keywords": "container washed",
          "label": "Miscellaneous"
        },
        {
          "keywords": "trip charge",
          "label": "Trip Charge"
        },
        {
          "keywords": "fuel surcharge",
          "label": "Fuel Surcharge"
        },
        {
          "keywords": "rebate",
          "label": "Metal Rebate"
        },
        {
          "keywords": "misc",
          "label": "Miscellaneous"
        },
        {
          "keywords": "rental",
          "label": "Rental"
        },
        {
          "keywords": "equip svc",
          "label": "Rental"
        },
        {
          "keywords": "yd.ro",
          "label": "Rental"
        },
        {
          "keywords": "closedbox.ro",
          "label": "Rental"
        },
        {
          "keywords": "closed box single stream",
          "label": "Disposal"
        },
        {
          "keywords": "fl-comm",
          "label": "Monthly Service"
        },
        {
          "keywords": "flc-",
          "label": "Delivery"
        }
      ]
    },
    "weight_from_disposal": {
      "type": "copy_field_if",
      "condition_field": "charge_type",
      "condition_value": "Disposal",
      "source_field": "qty",
      "target_field": "weight",
      "set_fields": {
        "weight_unit": "TONS"
      }
    },
    "charge_code_normalize": {
      "type": "charge_normalize",
      "charge_type_field": "charge_type",
      "equipment_type_field": "equipment_type",
      "output_field": "charge_code",
      "equipment_class_map": {
        "FRONT_LOAD": "commercial",
        "OPEN_TOP": "industrial",
        "COMPACTOR": "industrial"
      },
      "charge_code_map": {
        "Disposal": "Disposal Charge",
        "Haul": "Empty & Return",
        "Monthly Service": "Monthly Service Commercial",
        "Delivery": {
          "commercial": "Delivery Commercial",
          "industrial": "Delivery Industrial"
        },
        "Fuel Surcharge": "FUEL SURCHARGE",
        "Metal Rebate": "Metal Rebate",
        "Trip Charge": "Miscellaneous",
        "Miscellaneous": "Miscellaneous",
        "Rental": "Monthly Rental Industrial"
      }
    },
    "schedule_classify": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "rules": [
        {
          "keywords": "open_top",
          "label": "ON_CALL"
        },
        {
          "keywords": "compactor",
          "label": "ON_CALL"
        }
      ]
    },
    "_set_desc_lower": {
      "type": "set_field",
      "source_field": "description",
      "output_field": "_desc_lower",
      "transform": "lower"
    },
    "parent_container": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "both",
      "skip_zero": true
    },
    "post_schedule": {
      "type": "per_charge_post",
      "charges_field": "_charges",
      "transforms": [
        {
          "type": "keyword_classify",
          "source_field": "equipment_type",
          "output_field": "schedule",
          "skip_if_set": "schedule",
          "rules": [
            {
              "keywords": "open_top",
              "label": "ON_CALL"
            },
            {
              "keywords": "compactor",
              "label": "ON_CALL"
            }
          ]
        }
      ]
    }
  },
  "charge_pipeline": {
    "source_field": "_body",
    "context_fields": [],
    "body_strip": [
      {
        "pattern": "^.*?CHARGES THIS INVOICE\\s*\\n",
        "flags": [
          "DOTALL"
        ],
        "replacement": ""
      },
      {
        "pattern": "\\*{3}NOW OFFERING.*$",
        "flags": [
          "DOTALL"
        ],
        "replacement": ""
      },
      {
        "pattern": "\\nCurrent\\s+Charges.*$",
        "flags": [
          "DOTALL"
        ],
        "replacement": ""
      }
    ],
    "block_split": {
      "pattern": "Site\\s+(?P<site_id>\\d+)\\s+-\\s+(?P<site_name>.+?)\\s*\\nDATE\\s+DESCRIPTION.*?\\n(?P<lines>.*?)(?=Site\\s+\\d+\\s+-|$)",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "field_map": {
        "site_id": "site_id",
        "site_name": "site_name"
      },
      "text_group": "lines",
      "fallback_flat": true
    },
    "line_join_config": {
      "new_line_pattern": "^\\d{1,2}/\\d{1,2}/\\d{2,4}|^Tax\\b|^Site Total|^NOTES|^DATE\\s+DESC|^\\d+yd\\.|^ClosedBox|^RO_|^FLC?-|^Fuel",
      "skip_join_patterns": [
        "^NOTES AND COMMENTS",
        "^J\\s*oin us",
        "^Please visit",
        "^DATE\\s+DESCRIPTION",
        "^DATE\\s+REFERENCE"
      ]
    },
    "skip_patterns": [
      "^Site Total",
      "^NOTES AND COMMENTS",
      "^J\\s*oin us",
      "^Please visit",
      "^DATE\\s+DESCRIPTION",
      "^DATE\\s+REFERENCE",
      "CUSTOMER PO#",
      "^Previous Balance",
      "^PAYMENTS RECEIVED"
    ],
    "charge_detect": {
      "date_pattern": "^(\\d{1,2}/\\d{1,2}/\\d{2,4})(?:\\s*-\\s*(\\d{1,2}/\\d{1,2}/\\d{2,4}))?",
      "date_format": "{0}"
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|(?<![-\\d])\\$?([\\d,]+\\.\\d{2})|-([\\d,]+\\.\\d{2})",
      "amount_mode": "last3_qru",
      "min_amounts": 2,
      "wo_pattern": "(?:^|\\s)(\\d{7})(?:\\s|$)",
      "desc_extract_mode": "before_wo",
      "weight_pattern": "([\\d.]+)\\s*(?:Tons?|tons?)"
    },
    "special_lines": [
      {
        "pattern": "^Tax\\b",
        "fields": {
          "description": "Tax",
          "charge_type": "Tax",
          "charge_code": "Tax"
        }
      },
      {
        "pattern": "^\\d+yd\\.RO",
        "fields": {
          "charge_type": "Rental",
          "charge_code": "Monthly Rental Industrial",
          "equipment_type": "OPEN_TOP"
        }
      },
      {
        "pattern": "^ClosedBox\\.RO",
        "fields": {
          "charge_type": "Rental",
          "charge_code": "Monthly Rental Industrial",
          "equipment_type": "OPEN_TOP"
        }
      },
      {
        "pattern": "^RO_Compactor",
        "fields": {
          "charge_type": "Rental",
          "charge_code": "Monthly Rental Industrial",
          "equipment_type": "COMPACTOR"
        }
      },
      {
        "pattern": "^Fuel Surcharge",
        "fields": {
          "charge_type": "Fuel Surcharge",
          "charge_code": "FUEL SURCHARGE"
        }
      }
    ],
    "per_charge_transforms": [
      "_set_desc_lower",
      "equip_classify",
      "schedule_classify",
      "size_extract_fl",
      "size_format",
      "material_classify",
      "charge_type_classify",
      "weight_from_disposal",
      "charge_code_normalize"
    ],
    "post_processing": [
      "parent_container",
      "post_schedule"
    ]
  },
  "output_spec": {
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total",
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "site_id",
      "site_name",
      "service_date",
      "description",
      "wo_number",
      "qty",
      "unit_rate",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_total",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address",
      "site_id",
      "site_name",
      "wo_number",
      "qty",
      "unit_rate"
    ]
  }
}
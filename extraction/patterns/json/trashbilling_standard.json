{
  "format_label": "trashbilling_standard",
  "vendor_name": "TrashBilling Standard",
  "routing_regex": "INVOICE#.*(?:INV|NV)\\s*DATE.*ACCOUNT[#H]",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "INVOICE#\\s*(?P<invoice_number>\\S+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "ACCOUNT#\\s*(?P<account_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "INV\\s+DATE\\s+(?P<invoice_date>\\d{2}/\\d{2}/\\d{2,4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "(?:CURRENT|AMOUNT)\\s+(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "(?:SERVICE\\s+ADDRESS|LOCATION)[^\\n]*\\n(.*?)(?:ACCT#|PAGE\\s+\\d|CURRENT.*30\\s+DAY)",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "SERVICE\\s+ADDRESS:\\s*(?P<service_address>[^\\n(]+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_address": "service_address"}
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%y",
        "%m/%d/%Y"
      ]
    },
    "date_service": {
      "type": "date_parse",
      "field": "service_date",
      "formats": [
        "%m/%d/%y",
        "%m/%d/%Y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "rolloff",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "roll off",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "roll-off",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "hauling",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "landfill",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "disposal",
          "label": "ROLL_OFF"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycl",
          "label": "RECYCLING"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        },
        {
          "keywords": "organic",
          "label": "ORGANICS"
        }
      ],
      "default": "MSW"
    },
    "size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "(\\d+)\\s*[Yy](?:[Dd]|ARD)?\\b",
      "flags": [
        "IGNORECASE"
      ],
      "transform": "{0} YD"
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "fuel",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "surcharge",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "environmental",
          "label": "Environmental Surcharge"
        },
        {
          "keywords": "rent",
          "label": "Container Rental"
        },
        {
          "keywords": "hauling",
          "label": "Haul"
        },
        {
          "keywords": "landfill",
          "label": "Disposal"
        },
        {
          "keywords": "disposal",
          "label": "Disposal"
        }
      ],
      "default": "Scheduled Service"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "fuel",
          "label": "SURCHARGE"
        },
        {
          "keywords": "surcharge",
          "label": "SURCHARGE"
        },
        {
          "keywords": "environmental",
          "label": "SURCHARGE"
        },
        {
          "keywords": "rent",
          "label": "RENTAL"
        },
        {
          "keywords": "hauling",
          "label": "ON_CALL"
        },
        {
          "keywords": "landfill",
          "label": "ON_CALL"
        },
        {
          "keywords": "disposal",
          "label": "ON_CALL"
        }
      ],
      "default": "RECURRING"
    },
    "schedule_extract": {
      "type": "regex_parse_multi",
      "source_field": "description",
      "pattern": "(?P<count>\\d+)XW\\b",
      "flags": [
        "IGNORECASE"
      ],
      "group_outputs": [
        {
          "group": "count",
          "output_field": "schedule",
          "format": "Weekly x{value}"
        }
      ],
      "skip_if_set": "schedule"
    },
    "schedule_oncall": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "skip_if_set": true,
      "rules": [
        {
          "keywords": "roll_off",
          "label": "ON_CALL"
        },
        {
          "keywords": "compactor",
          "label": "ON_CALL"
        }
      ]
    },
    "schedule_monthly": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "skip_if_set": true,
      "rules": []
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{2,4})",
      "date_format": "{0}",
      "require_date": false
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|([\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "skip_patterns": [
      "PAYMENT",
      "PRIOR\\s+BALANCE",
      "TON\\s+MIN",
      "<[\\d,]+\\.\\d{2}>",
      "(?i)mailed\\s+paper\\s+invoices",
      "(?i)credit\\s+card\\s+fee",
      "^\\s*$"
    ],
    "per_charge_transforms": [
      "date_service",
      "equipment_detect",
      "schedule_extract",
      "schedule_oncall",
      "schedule_monthly",
      "material_detect",
      "size_extract",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": []
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": false,
    "total_field": "bill_total"
  }
}
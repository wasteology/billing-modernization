{
  "format_label": "rumpke",
  "vendor_name": "Rumpke",
  "routing_regex": "RUMPKE|3700\\s+STRUBLE\\s+RD|0201174\\d+.*(?:Service\\s+Period|CINCINNATI)",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "Invoice\\s*#:?\\s*(?P<invoice_number>\\d{7})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "Customer\\s*#:?\\s*(?P<account_number>\\d{10})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "Date:\\s*(?P<invoice_date>\\d{2}/\\d{2}/\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "Invoice\\s+Total:\\s*(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "Invoice\\s+Total:[^\\n]*\\n(.*)TOTAL\\s+INVOICE:",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "(?P<service_address>WASTE\\s+HARMONICS[^/\\n]*/NORTHROP)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_address": "service_address"}
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%y"
      ]
    },
    "date_service": {
      "type": "date_parse",
      "field": "service_date",
      "formats": [
        "%m/%d/%y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "ro",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "fl",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "cart",
          "label": "CART"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "crdbd",
          "label": "OCC"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        },
        {
          "keywords": "com mix",
          "label": "RECYCLING"
        },
        {
          "keywords": "recy",
          "label": "RECYCLING"
        },
        {
          "keywords": "single stream",
          "label": "RECYCLING"
        },
        {
          "keywords": "organic",
          "label": "ORGANICS"
        }
      ],
      "default": "MSW"
    },
    "size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "(\\d+\\s*YD)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "fuel surcharge",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "lease",
          "label": "Container Rental"
        },
        {
          "keywords": "rent",
          "label": "Container Rental"
        },
        {
          "keywords": "finance",
          "label": "Late Fee"
        },
        {
          "keywords": "tax",
          "label": "Sales Tax"
        },
        {
          "keywords": "disp",
          "label": "Disposal"
        },
        {
          "keywords": "load",
          "label": "Haul"
        },
        {
          "keywords": "haul",
          "label": "Haul"
        },
        {
          "keywords": "extra",
          "label": "Extra Pickup"
        }
      ],
      "default": "Scheduled Service"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "lease",
          "label": "RENTAL"
        },
        {
          "keywords": "rent",
          "label": "RENTAL"
        },
        {
          "keywords": "load",
          "label": "ON_CALL"
        },
        {
          "keywords": "haul",
          "label": "ON_CALL"
        },
        {
          "keywords": "disp",
          "label": "ON_CALL"
        },
        {
          "keywords": "tax",
          "label": "TAX"
        },
        {
          "keywords": "fuel",
          "label": "SURCHARGE"
        },
        {
          "keywords": "finance",
          "label": "FEE"
        }
      ],
      "default": "RECURRING"
    },
    "parent_inherit": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "both"
    },
    "schedule_extract": {
      "type": "regex_parse_multi",
      "source_field": "description",
      "pattern": "P/U:\\s*(?P<count>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "group_outputs": [
        {
          "group": "count",
          "output_field": "schedule",
          "format": "Weekly x{value}"
        }
      ],
      "skip_if_set": "schedule"
    },
    "schedule_oncall": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "skip_if_set": true,
      "rules": [
        {
          "keywords": "roll_off",
          "label": "ON_CALL"
        },
        {
          "keywords": "compactor",
          "label": "ON_CALL"
        }
      ]
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{2})",
      "date_format": "{0}",
      "require_date": true
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$?(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total",
      "weight_pattern": "(\\d+\\.\\d{3})"
    },
    "skip_patterns": [
      "^\\s*WORK\\s+ORDER",
      "^\\s*SUB\\s+TOTAL",
      "^\\s*TOTAL\\s+TAXES",
      "^\\s*MSW\\s+COMMERCIAL",
      "^\\s*$"
    ],
    "per_charge_transforms": [
      "date_service",
      "equipment_detect",
      "schedule_extract",
      "schedule_oncall",
      "material_detect",
      "size_extract",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": [
      "parent_inherit"
    ]
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
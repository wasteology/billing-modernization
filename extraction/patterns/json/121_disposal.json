{
  "vendor_name": "121 Disposal",
  "format_label": "121_disposal",
  "routing_regex": "121\\s+Disposal\\s+Co\\..*(?:Invoice|Document)\\s+#",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "routing_priority": 50,
  "is_active": true,
  "sample_md5": null,
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "(?:Invoice|Document)\\s+#\\s*(?P<invoice_number>INV\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "(?:INVOICE\\s+DATE|Date)\\s+(?P<invoice_date>\\d{1,2}/\\d{1,2}/\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "(?:CUSTOMER\\s+NO|ACCOUNT\\s+#)\\s+(?P<account_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "(?:INVOICE\\s+TOTAL|Total\\s+Charges|Current\\s+Charges)\\s+\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "(?:QNTY|Allowence|RATE|AMOUNT|Description|Service\\s+Description\\s+Price)\\s*\\n(?P<body>.*?)(?:Total\\s+Charges|TOTAL\\s+CHARGES|Invoice\\s+Total|Current\\s+Charges)",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": "body"
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "Site:\\s*[^,]+,\\s*(?P<service_address>[^\\n]+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_address": "service_address"}
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%Y"
      ]
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "processing/disposal",
          "label": "Disposal Charge"
        },
        {
          "keywords": "disposal",
          "label": "Disposal Charge"
        },
        {
          "keywords": "dump and return",
          "label": "Empty & Return"
        },
        {
          "keywords": "haul",
          "label": "Empty & Return"
        },
        {
          "keywords": "delivery",
          "label": "Delivery Industrial"
        },
        {
          "keywords": "rental",
          "label": "Monthly Rental Industrial"
        },
        {
          "keywords": "removal",
          "label": "Final Pick Up"
        }
      ],
      "default": "Empty & Return"
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "roll off",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "closed top",
          "label": "ROLL_OFF"
        }
      ],
      "default": "ROLL_OFF"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "c&d",
          "label": "C&D"
        },
        {
          "keywords": "msw",
          "label": "MSW"
        },
        {
          "keywords": "recycle",
          "label": "RECYCLING"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        }
      ],
      "default": "MSW"
    },
    "schedule_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "schedule",
      "rules": [],
      "default": "ON_CALL"
    },
    "equipment_size_extract": {
      "type": "regex_parse_multi",
      "source_field": "description",
      "pattern": "(?P<size_num>\\d+)\\s*(?P<size_unit>YD|YARD)",
      "flags": [
        "IGNORECASE"
      ],
      "group_outputs": [
        {
          "group": "size_num",
          "output_field": "_size_num"
        },
        {
          "group": "size_unit",
          "output_field": "_size_unit",
          "map": {
            "YD": "YD",
            "yd": "YD",
            "YARD": "YD",
            "Yard": "YD"
          }
        }
      ]
    },
    "equipment_size_format": {
      "type": "concat_fields",
      "fields": [
        "_size_num",
        "_size_unit"
      ],
      "separator": " ",
      "output_field": "equipment_size"
    },
    "surcharge_inherit": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "both",
      "skip_zero": false
    }
  },
  "charge_pipeline": {
    "mode": "flat",
    "source_field": "_body",
    "line_join_config": {
      "new_line_pattern": "^(?:J\\s*\\)?\\s*OB|ORD|Site:|Roll\\s+Off|Subtotal|Northrop|Rental|\\d{2}/\\d{2}/\\d{4})"
    },
    "service_line": {
      "pattern": "^ORD\\d+,\\s*(?P<equipment_size>\\d+\\s*YD)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "equipment_size": "equipment_size"
      }
    },
    "context_fields": [
      "equipment_size"
    ],
    "skip_patterns": [
      "^\\s*$",
      "^\\s*Site:",
      "^\\s*Roll\\s+Off\\s*$",
      "^\\s*Subtotal",
      "^\\s*Northrop"
    ],
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{4})",
      "date_format": "{0}"
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$?(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total",
      "weight_pattern": "tons\\s+(\\d+\\.\\d+)"
    },
    "per_charge_transforms": [
      "charge_code_classify",
      "equipment_detect",
      "material_detect",
      "schedule_detect",
      "equipment_size_extract",
      "equipment_size_format"
    ],
    "post_processing": [
      "surcharge_inherit"
    ]
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
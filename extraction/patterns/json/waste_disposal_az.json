{
  "format_label": "waste_disposal_az",
  "vendor_name": "Waste Disposal LLC",
  "routing_regex": "Waste\\s+Disposal.*Invoice\\s+Number:",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "Invoice\\s+Number:\\s*(?P<invoice_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "Customer\\s+Number:\\s*(?P<account_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "Date\\s+Billed:\\s*(?P<invoice_date>\\d{1,2}/\\d{1,2}/\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "Invoice\\s+Total:\\s*\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "Subtotal[^\\n]*\\n(.*)Invoice\\s+Total:",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    },
    {
      "name": "service_street",
      "method": "search",
      "pattern": "HARMONICS\\s*\\n(?P<service_street>\\d+\\s+[^\\n]+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_street": "service_street"}
    },
    {
      "name": "service_city",
      "method": "search",
      "pattern": "HARMONICS\\s*\\n[^\\n]+\\n(?P<service_city>[^\\n]+AZ[^\\n]+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_city": "service_city"}
    },
    {
      "name": "service_address_fallback",
      "method": "search",
      "pattern": "(?P<fallback_addr>NORTHROP\\s+GRUMMAN\\s+C/O\\s+WASTE\\s+HARMONICS)",
      "flags": ["IGNORECASE"],
      "field_map": {"fallback_addr": "_fallback_addr"},
      "skip_if_set": ["service_street"]
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format",
    "addr_concat",
    "fallback_copy"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%Y"
      ]
    },
    "addr_concat": {
      "type": "concat_fields",
      "fields": ["service_street", "service_city"],
      "separator": ", ",
      "output_field": "service_address",
      "skip_empty": true
    },
    "fallback_copy": {
      "type": "copy_if_null",
      "source_field": "_fallback_addr",
      "target_field": "service_address"
    },
    "date_service": {
      "type": "date_parse",
      "field": "service_date",
      "formats": [
        "%m/%d/%Y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [],
      "default": "ROLL_OFF"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [],
      "default": "MSW"
    },
    "size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "(\\d+\\s*[Yy]ard)",
      "flags": [
        "IGNORECASE"
      ]
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "over tonnage",
          "label": "Overage"
        },
        {
          "keywords": "swap",
          "label": "Haul"
        },
        {
          "keywords": "pull",
          "label": "Haul"
        },
        {
          "keywords": "deliver",
          "label": "Haul"
        },
        {
          "keywords": "exchange",
          "label": "Haul"
        }
      ],
      "default": "Haul"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [],
      "default": "ON_CALL"
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": "(\\d{1,2}/\\d{1,2}/\\d{4})",
      "date_format": "{0}",
      "require_date": false
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$([\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "skip_patterns": [
      "^\\s*$"
    ],
    "per_charge_transforms": [
      "date_service",
      "equipment_detect",
      "material_detect",
      "size_extract",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": []
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
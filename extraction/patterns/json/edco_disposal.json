{
  "format_label": "edco_disposal",
  "vendor_name": "EDCO Disposal",
  "routing_regex": "EDCO\\s+DISPOSAL\\s+CORPORATION",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "account_date",
      "method": "search",
      "pattern": "(?P<account_number>\\d{2}-[A-Z]{2}\\s+\\d{6})\\s+(?P<invoice_date>\\d{2}/\\d{2}/\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number",
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "CURRENT\\s+CHARGES:\\s+(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "MO\\s+DAY.*?BALANCE[^\\n]*\\n(.*)CURRENT\\s+CHARGES:",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "(?:BALANCE\\s+FORWARD|MO\\s+DAY)[^\\n]*\\n(?:(?:\\d[\\d\\s]*\\s+(?:PAYMENT|DECREASE|CHECK|CREDIT)[^\\n]*)\\n)*(?P<service_address>\\d{4,5}\\s+[A-Z][^\\d\\n][^\\n]*(?:BLVD|AVE|ST|DR|RD|WAY|LN|CT|CIR|PL|LANE|GREENCRAIG)\\b[^\\n]*)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_address": "service_address"}
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "roll off",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "b-box",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "load b",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "rent",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "cart",
          "label": "CART"
        },
        {
          "keywords": "toter",
          "label": "CART"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycle",
          "label": "RECYCLING"
        },
        {
          "keywords": "single stream",
          "label": "RECYCLING"
        },
        {
          "keywords": "organic",
          "label": "ORGANICS"
        },
        {
          "keywords": "green waste",
          "label": "GREEN_WASTE"
        },
        {
          "keywords": "yard waste",
          "label": "YARD_WASTE"
        }
      ],
      "default": "MSW"
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "rent",
          "label": "Container Rental"
        },
        {
          "keywords": "extra",
          "label": "Extra Pickup"
        },
        {
          "keywords": "fuel",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "disposal",
          "label": "Disposal"
        },
        {
          "keywords": "haul",
          "label": "Haul"
        },
        {
          "keywords": "load",
          "label": "Haul"
        }
      ],
      "default": "Scheduled Service"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "rent",
          "label": "RENTAL"
        },
        {
          "keywords": "haul",
          "label": "ON_CALL"
        },
        {
          "keywords": "load",
          "label": "ON_CALL"
        },
        {
          "keywords": "disposal",
          "label": "ON_CALL"
        }
      ],
      "default": "RECURRING"
    },
    "parent_inherit": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "both"
    },
    "schedule_default": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "rules": []
    },
    "schedule_oncall": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "skip_if_set": true,
      "rules": [
        {
          "keywords": "roll_off",
          "label": "ON_CALL"
        },
        {
          "keywords": "compactor",
          "label": "ON_CALL"
        }
      ]
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "body_strip": [
      {
        "pattern": "(\\d+)-(\\d{2})(?=\\s*$)",
        "replacement": "\\1.\\2",
        "flags": [
          "MULTILINE"
        ]
      }
    ],
    "charge_detect": {
      "require_date": false
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$?(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "skip_patterns": [
      "BALANCE\\s+FORWARD",
      "PAYMENT",
      "CURRENT\\s+CHARGES",
      "DECREASE",
      "^\\s*$"
    ],
    "per_charge_transforms": [
      "equipment_detect",
      "schedule_oncall",
      "schedule_default",
      "material_detect",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": [
      "parent_inherit"
    ]
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
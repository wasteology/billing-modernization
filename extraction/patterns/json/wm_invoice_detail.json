      "source_field": "description",
      "output_field": "schedule",
      "skip_if_set": true,
      "rules": [
        {
          "keywords": "weekly",
          "label": "Weekly x1"
        },
        {
          "keywords": "daily",
          "label": "Daily x1"
        }
      ]
    },
    "schedule_oncall": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "skip_if_set": true,
      "rules": [
        {
          "keywords": "open_top",

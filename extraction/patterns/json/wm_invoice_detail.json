{
  "vendor_name": "Waste Management",
  "format_label": "wm_invoice_detail",
  "routing_regex": "WASTE\\s+MANAGEMENT.*INVOICE\\s+DETAIL",
  "routing_flags": [
    "DOTALL"
  ],
  "routing_priority": 50,
  "is_active": true,
  "sample_md5": null,
  "extraction_stages": [
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "INVOICE\\s+DETAIL\\s+DATE\\s+(?P<invoice_date>\\d{2}/\\d{2}/\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "account_name",
      "method": "search",
      "pattern": "ACCOUNT\\s+NAME:\\s*(?P<account_name>.+?)\\s*TIME\\s+\\d{2}:\\d{2}:\\d{2}",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "field_map": {
        "account_number": "account_name"
      }
    },
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "INVOICE\\s+NUMBER:\\s*(?P<invoice_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "TOTAL\\s+AMOUNT\\s+DUE\\s+\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "INVOICE\\s+NUMBER:\\s*\\d+\\s*\\n(?P<body>.*?)TOTAL\\s+AMOUNT\\s+DUE",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": "body"
    }
  ],
  "execution_plan": [
    "bill_total_parse"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "vendor_account_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "pattern": "(WHM\\d+NG|\\d{3}-\\d{4,6})",
      "output_field": "vendor_account",
      "group": 1,
      "skip_if_set": true
    },
    "weight_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "pattern": "(\\d*\\.?\\d+)\\s*Tons?",
      "output_field": "weight",
      "group": 1,
      "flags": [
        "IGNORECASE"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "dmpfl",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": " dmp ",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": " dmp\n",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": " ot ",
          "label": "OPEN_TOP"
        },
        {
          "keywords": " ot\n",
          "label": "OPEN_TOP"
        },
        {
          "keywords": " cmp",
          "label": "COMPACTOR"
        },
        {
          "keywords": " tot ",
          "label": "CART"
        },
        {
          "keywords": " rl ",
          "label": "REAR_LOAD"
        }
      ]
    },
    "equipment_size_extract": {
      "type": "regex_parse_multi",
      "source_field": "description",
      "pattern": "(?P<size_num>\\d+\\.?\\d*)\\s*(?P<size_unit>Yards?|Gal(?:lon)?s?)",
      "flags": [
        "IGNORECASE"
      ],
      "group_outputs": [
        {
          "group": "size_num",
          "output_field": "_size_num"
        },
        {
          "group": "size_unit",
          "output_field": "_size_unit",
          "map": {
            "Yards": "YD",
            "Yard": "YD",
            "Gallons": "GAL",
            "Gallon": "GAL",
            "Gal": "GAL"
          }
        }
      ]
    },
    "equipment_size_format": {
      "type": "concat_fields",
      "fields": [
        "_size_num",
        "_size_unit"
      ],
      "separator": " ",
      "output_field": "equipment_size"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": [
            "green",
            "waste"
          ],
          "label": "Green Waste"
        },
        {
          "keywords": "co-mingle",
          "label": "Recycling"
        },
        {
          "keywords": "co mingle",
          "label": "Recycling"
        },
        {
          "keywords": "comingle",
          "label": "Recycling"
        },
        {
          "keywords": " metal",
          "label": "Scrap Metal"
        },
        {
          "keywords": "compost",
          "label": "Organics"
        },
        {
          "keywords": [
            "single",
            "stream"
          ],
          "label": "Single Stream"
        },
        {
          "keywords": [
            "food",
            "waste"
          ],
          "label": "Organics"
        },
        {
          "keywords": [
            "organic",
            "waste"
          ],
          "label": "Organics"
        },
        {
          "keywords": "organics",
          "label": "Organics"
        },
        {
          "keywords": "organic",
          "label": "Organics"
        },
        {
          "keywords": [
            "construction",
            "demolition"
          ],
          "label": "C&D"
        },
        {
          "keywords": "construction",
          "label": "C&D"
        },
        {
          "keywords": "recyclables",
          "label": "Recycling"
        },
        {
          "keywords": "recycling",
          "label": "Recycling"
        },
        {
          "keywords": "recyclin",
          "label": "Recycling"
        },
        {
          "keywords": " occ",
          "label": "OCC"
        },
        {
          "keywords": "cardboard",
          "label": "Cardboard"
        },
        {
          "keywords": "wood",
          "label": "Wood"
        },
        {
          "keywords": " msw",
          "label": "MSW"
        },
        {
          "keywords": "trash",
          "label": "Trash"
        }
      ]

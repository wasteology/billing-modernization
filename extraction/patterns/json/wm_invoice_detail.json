    "schedule_extract": {
      "type": "regex_parse_multi",
      "source_field": "description",
      "pattern": "(?P<freq>Weekly|Monthly|Daily)\\b.{0,80}?x\\s*(?P<mult>[0-9l]{1,2})(?!\\d)",
      "flags": [
        "IGNORECASE"
      ],
      "group_outputs": [
        {
          "group": "freq",
          "output_field": "_sched_freq"
        },
        {
          "group": "mult",
          "output_field": "_sched_mult",
          "map": {
            "l": "1"
          }
        }
      ]
    },
    "schedule_format": {
      "type": "concat_fields",
      "fields": [
        "_sched_freq",
        "_sched_mult"
      ],
      "separator": " x",
      "output_field": "schedule"
    },

    "addr_concat": {
      "type": "concat_fields",
      "fields": [
        "addr_street",
        "addr_city"
      ],
      "separator": ", ",
      "output_field": "service_address"
    }
  },
  "charge_pipeline": {
    "source_field": "_body",
    "chunk_mode": "date_split_raw",
    "block_split": {
      "pattern": "(?P<lines>.*?)LOCATION\\s+CHARGES\\s+(?P<location_subtotal>[\\d,]+\\.\\d{2})",
      "flags": [
        "DOTALL"
      ],
      "text_group": "lines",
      "field_map": {
        "location_subtotal": "location_subtotal"
      }
    },
    "body_strip": [
      {
        "pattern": "WASTE\\s+MANAGEMENT,?\\s*INC\\.?\\s+PAGE\\s+\\d+\\s*\\nINVOICE\\s+DETAIL\\s+DATE\\s+\\d{2}/\\d{2}/\\d{4}\\s*\\n(?:[^\\n]*\\n){0,5}?[^\\n]*AMOUNT\\s*\\n",
        "replacement": "",
        "flags": []
      },
      {
        "pattern": "^LOCATION\\s+ID.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^COMPANY\\s+CODE.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^SERVICE\\s+(NAME|ADDRESS).*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^VENDOR\\s+ACCOUNT.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*SCode:.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*ween\\s+eeee.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*meee\\s+eeee.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^.*eee\\s+ee\\s+ne.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^WHM\\d+NG\\s*-\\s*LOCATION\\s+TOTAL.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^REMIT\\s+TO.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^UNLESS\\s+THE\\s+TERMS.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^\\d{4}[ \\t]+\\d{3,}[ \\t]+[A-Z].*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      }
    ],
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{4})",
      "date_format": "{0}",
      "require_date": true
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|(?<!x)(-?[\\d,]+\\.\\d{2})(?!\\d|%)",
      "amount_mode": "last_is_total",
      "desc_extract_mode": "after_date",
      "weight_pattern": "(\\d*\\.?\\d+)\\s*Tons?"
    },
    "skip_patterns": [],
    "per_charge_transforms": [
      "addr_concat",
      "vendor_account_extract",
      "weight_extract",
      "equipment_detect",
      "equipment_size_extract",
      "equipment_size_format",
      "material_detect",
      "schedule_extract",
      "schedule_format",
      "description_extract",
      "charge_code_normalize",
      "schedule_fallback",
      "schedule_oncall"
    ],
    "post_processing": [
      "parent_container_resolve",
      "renormalize_after_parent"
    ],
    "block_context": {
      "pattern": "/[^\\n]*\\n(?:(?!\\d)[^\\n]*\\n){0,5}(?P<addr_street>\\d+[^\\n]+?)(?=\\s+\\d{2}/\\d{2}/\\d{4}|\\n)[^\\n]*\\n(?:(?:[^\\n]+\\n){0,2}(?P<addr_city>[A-Z][^\\n]+?\\d{5}))?",
      "flags": [
        "MULTILINE"
      ],
      "field_map": {
        "addr_street": "addr_street",
        "addr_city": "addr_city"
      }
    }
  },
  "output_spec": {
    "header_fields": [
      "invoice_date",
      "account_number",
      "invoice_number",
      "bill_total"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "charge_type",
      "weight",
      "weight_unit",
      "vendor_account",
      "location_subtotal",
      "service_address"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address",
      "vendor_account",
      "location_subtotal"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  },
  "notes": "WM Invoice Detail format. 265 of 279 WM invoices match this routing. Uses date_split_raw chunk mode for OCR column interleaving."
}
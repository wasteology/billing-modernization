{
  "format_label": "aaa_rubbish",
  "vendor_name": "AAA Rubbish",
  "routing_regex": "AAA\\s*Rubbish|AAArubbis",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "Invoice\\s+Number:\\s*(?P<invoice_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "Invoice\\s+Date:\\s*(?P<invoice_date>\\d{2}/\\d{2}/\\d{2,4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "Current\\s+Charges\\s+(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "(?:Account\\s+Number|P\\.?O\\.?\\s+Number):\\s*(?P<account_number>[\\d]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "Total\\s+Amount\\s+Due\\s+[\\d,.]+\\s*\\n(.*?)(?:Payment\\s+Coupon|Invoice\\s+Number)",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    },
    {
      "name": "service_street",
      "method": "search",
      "pattern": "NORTHROP\\s+GRUMM[A-Z]+\\s*\\n(?P<service_street>\\d+\\s+[^\\n]+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_street": "service_street"}
    },
    {
      "name": "service_city",
      "method": "search",
      "pattern": "NORTHROP\\s+GRUMM[A-Z]+\\s*\\n[^\\n]+\\n(?:ee\\s+)?(?P<service_city>[A-Z][A-Z0-9 ]+(?:CA|AL|VA|TX|FL|OH|CO|UT|NY|MD|MN|AZ|LA|NC|CT|DE|MS|WV|WI|MA|ME|OK)\\s+\\d+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_city": "service_city"}
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format",
    "addr_concat"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%y",
        "%m/%d/%Y"
      ]
    },
    "addr_concat": {
      "type": "concat_fields",
      "fields": ["service_street", "service_city"],
      "separator": ", ",
      "output_field": "service_address",
      "skip_empty": true
    },
    "date_service": {
      "type": "date_parse",
      "field": "service_date",
      "formats": [
        "%m/%d/%y",
        "%m/%d/%Y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "rolloff",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "environmental",
          "label": "ROLL_OFF"
        }
      ],
      "default": "ROLL_OFF"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycl",
          "label": "RECYCLING"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        }
      ],
      "default": "MSW"
    },
    "size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "(\\d+)\\s*[Yy](?:[Dd]|ARD)?\\b",
      "flags": [
        "IGNORECASE"
      ]
    },
    "weight_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "weight",
      "pattern": "([\\d.]+)\\s*TN",
      "flags": [
        "IGNORECASE"
      ]
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "environmental",
          "label": "Environmental Surcharge"
        },
        {
          "keywords": "fuel",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "surcharge",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "rent",
          "label": "Container Rental"
        }
      ],
      "default": "Haul"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "environmental",
          "label": "SURCHARGE"
        },
        {
          "keywords": "fuel",
          "label": "SURCHARGE"
        },
        {
          "keywords": "surcharge",
          "label": "SURCHARGE"
        },
        {
          "keywords": "rent",
          "label": "RENTAL"
        }
      ],
      "default": "ON_CALL"
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{2,4})",
      "date_format": "{0}",
      "require_date": false
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|([\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "skip_patterns": [
      "^\\s*$",
      "P\\.?O\\.?\\s*#",
      "TN\\s+RATE",
      "BANDINI",
      "COMMERCE",
      "Description/Notes",
      "Reference.*charges"
    ],
    "per_charge_transforms": [
      "date_service",
      "equipment_detect",
      "material_detect",
      "size_extract",
      "weight_extract",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": []
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
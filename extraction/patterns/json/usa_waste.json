{
  "format_label": "usa_waste",
  "vendor_name": "USA Waste & Recycling",
  "routing_regex": "USA\\s+(?:WASTE|HAULING)\\s+&\\s+RECYCLING,?\\s+INC",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "INVOICE\\s+#\\s+(?P<invoice_number>\\d{10})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "ACCOUNT\\s+#\\s+(?P<account_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "DUE\\s+DATE:?\\s+(?P<invoice_date>\\d{1,2}/\\d{1,2}/\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "(?:Invoice\\s+Total|TOTAL\\s+CHARGES\\s+THIS\\s+INVOICE):?\\s+\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "CHARGES\\s+THIS\\s+INVOICE\\s*\\n(.*?)(?:Invoice\\s+Total|TOTAL\\s+CHARGES|TAXES)",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    },
    {
      "name": "body_fallback",
      "method": "body_extract",
      "pattern": "(\\d{2}/\\d{2}/\\d{2}\\s+.*?)(?:TAXES|TOTAL\\s+CHARGES)",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1,
      "skip_if_set": [
        "body"
      ]
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "Location:\\s*(?P<service_address>[^\\n]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "service_address": "service_address"
      }
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%Y"
      ]
    },
    "date_service": {
      "type": "date_parse",
      "field": "service_date",
      "formats": [
        "%m/%d/%y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "roll off",
          "label": "ROLL_OFF"
        },
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "gal",
          "label": "CART"
        },
        {
          "keywords": "cart",
          "label": "CART"
        },
        {
          "keywords": "toter",
          "label": "CART"
        },
        {
          "keywords": "front load",
          "label": "FRONT_LOAD"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "single stream",
          "label": "RECYCLING"
        },
        {
          "keywords": "recycling",
          "label": "RECYCLING"
        },
        {
          "keywords": "occ",
          "label": "OCC"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        },
        {
          "keywords": "organic",
          "label": "ORGANICS"
        },
        {
          "keywords": "food",
          "label": "ORGANICS"
        }
      ],
      "default": "MSW"
    },
    "size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "(\\d+\\s*(?:YD|GAL))",
      "flags": [
        "IGNORECASE"
      ]
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "rent",
          "label": "Container Rental"
        },
        {
          "keywords": "extra pick",
          "label": "Extra Pickup"
        },
        {
          "keywords": "additional",
          "label": "Extra Pickup"
        },
        {
          "keywords": "fuel",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "energy",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "disposal",
          "label": "Disposal"
        },
        {
          "keywords": "haul",
          "label": "Haul"
        }
      ],
      "default": "Scheduled Service"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "rent",
          "label": "RENTAL"
        },
        {
          "keywords": "haul",
          "label": "ON_CALL"
        },
        {
          "keywords": "disposal",
          "label": "ON_CALL"
        }
      ],
      "default": "RECURRING"
    },
    "parent_inherit": {
      "type": "parent_container",
      "charges_field": "_charges",
      "inherit_fields": [
        "equipment_type",
        "equipment_size",
        "material",
        "schedule"
      ],
      "direction": "both"
    },
    "schedule_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "schedule",
      "rules": [],
      "default": null
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{2})(?:\\s+-\\s+\\d{2}/\\d{2}/\\d{2})?",
      "date_format": "{0}",
      "require_date": true
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$?(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "skip_patterns": [
      "^\\s*Service\\s+Loc",
      "^\\s*Current\\s+Charges",
      "^\\s*Sales\\s+Tax",
      "^\\s*Fuel\\s+Surcharge",
      "^\\s*$"
    ],
    "per_charge_transforms": [
      "date_service",
      "equipment_detect",
      "material_detect",
      "size_extract",
      "charge_code_classify",
      "charge_type_classify",
      "schedule_detect"
    ],
    "post_processing": [
      "parent_inherit"
    ]
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
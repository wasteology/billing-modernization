{
  "vendor_name": "Burgmeier's Hauling",
  "format_label": "burgmeier",
  "routing_regex": "BURGMEIER.S\\s+HAULING",
  "routing_flags": [
    "IGNORECASE"
  ],
  "routing_priority": 50,
  "is_active": true,
  "sample_md5": null,
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "INVOICE#\\s*(?P<invoice_number>\\S+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "INV\\s*DATE\\s*[\u2014\\-]?\\s*(?P<invoice_date>\\d{2}/\\d{2}/\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "ACCOUNT#\\s*(?P<account_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "ACCT#\\s*\\d+\\s+(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "PRIOR\\s+BALANCE\\s+[\\d,]+\\.\\d{2}\\s*\\n(?P<body>.*?)PAY\\s+ONLINE",
      "flags": [
        "DOTALL",
        "IGNORECASE"
      ],
      "output_field": "_body",
      "group": "body"
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "SERVICE\\s+ADDRESS:\\s*(?P<service_address>[^\\n]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "service_address": "service_address"
      }
    }
  ],
  "execution_plan": [
    "bill_total_parse"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "toter",
          "label": "CART"
        },
        {
          "keywords": "c/b",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "msw",
          "label": "FRONT_LOAD"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "equipment_size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "pattern": "(\\d+)\\s*Y",
      "output_field": "equipment_size",
      "group": 1,
      "flags": [
        "IGNORECASE"
      ],
      "transform": "{0} YD"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycling",
          "label": "Recycling"
        },
        {
          "keywords": "c/b",
          "label": "Cardboard"
        },
        {
          "keywords": "msw",
          "label": "MSW"
        },
        {
          "keywords": "trash",
          "label": "Trash"
        }
      ]
    },
    "schedule_extract": {
      "type": "regex_parse_multi",
      "source_field": "description",
      "pattern": "(?P<mult>\\d+)\\s*[xX]+\\s*(?P<freq>[WwMm])",
      "flags": [
        "IGNORECASE"
      ],
      "group_outputs": [
        {
          "group": "freq",
          "output_field": "_sched_freq",
          "map": {
            "W": "Weekly",
            "w": "Weekly",
            "M": "Monthly",
            "m": "Monthly"
          }
        },
        {
          "group": "mult",
          "output_field": "_sched_mult"
        }
      ]
    },
    "schedule_format": {
      "type": "concat_fields",
      "fields": [
        "_sched_freq",
        "_sched_mult"
      ],
      "separator": " x",
      "output_field": "schedule"
    },
    "charge_type_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "rental",
          "label": "Container Usage Charge"
        },
        {
          "keywords": "removal",
          "label": "Pickup"
        },
        {
          "keywords": "recycling",
          "label": "Pickup"
        }
      ],
      "default": "Pickup"
    },
    "schedule_rental_fallback": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "schedule",
      "skip_if_set": true,
      "rules": []
    },
    "charge_code_normalize": {
      "type": "charge_normalize",
      "charge_type_field": "charge_type",
      "equipment_type_field": "equipment_type",
      "output_field": "charge_code",
      "equipment_class_map": {
        "FRONT_LOAD": "commercial",
        "CART": "commercial"
      },
      "charge_code_map": {
        "Pickup": {
          "commercial": "Monthly Service Commercial"
        },
        "Container Usage Charge": {
          "commercial": "Monthly Rental Commercial"
        }
      }
    }
  },
  "charge_pipeline": {
    "source_field": "_body",
    "body_strip": [
      {
        "pattern": "^.*PAYMENT\\s+RECEIVED.*$",
        "replacement": "",
        "flags": [
          "MULTILINE",
          "IGNORECASE"
        ]
      },
      {
        "pattern": "^.*BPO\\s*#.*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      },
      {
        "pattern": "^[\\W\\s]*$",
        "replacement": "",
        "flags": [
          "MULTILINE"
        ]
      }
    ],
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{2})",
      "date_format": "{0}",
      "require_date": true
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|(-?[\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total",
      "desc_extract_mode": "after_date"
    },
    "skip_patterns": [],
    "per_charge_transforms": [
      "equipment_detect",
      "equipment_size_extract",
      "material_detect",
      "schedule_extract",
      "schedule_format",
      "schedule_rental_fallback",
      "charge_type_detect",
      "charge_code_normalize"
    ],
    "post_processing": []
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "charge_type",
      "weight_unit"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  },
  "notes": "Burgmeier's Hauling. 82 invoices, almost all single-charge. Charge line format: DATE |INV# QTY MATERIAL SIZE FREQ DESCRIPTION DATE_RANGE AMOUNT. MSW=Trash, C/B=Cardboard. All front load except toter rental."
}
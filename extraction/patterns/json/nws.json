{
  "format_label": "nws",
  "vendor_name": "National Waste Services",
  "routing_regex": "National\\s+Waste\\s+Services",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "(?P<invoice_number>\\d{7,8}[A-Z]?)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "P\\.?O\\.?\\s+No\\.?\\s*(?P<account_number>\\S+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "(?P<invoice_date>\\d{1,2}/\\d{1,2}/\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "(?:Invoice\\s+Total|Subtotal)\\s*:?\\s*\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "P\\.?O\\.?\\s+No\\.?[^\\n]*\\n(.*?)Subtotal",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "Northru?p\\s+Grumman\\s*\\n[.:]?\\s*(?P<service_address>\\d+[^\\n]+)",
      "flags": ["IGNORECASE"],
      "field_map": {"service_address": "service_address"}
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%Y"
      ]
    },
    "date_service": {
      "type": "date_parse",
      "field": "service_date",
      "formats": [
        "%m/%d/%Y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "compactor",
          "label": "COMPACTOR"
        },
        {
          "keywords": "roll off",
          "label": "ROLL_OFF"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycl",
          "label": "RECYCLING"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        }
      ],
      "default": "MSW"
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "recycl",
          "label": "Scheduled Service"
        },
        {
          "keywords": "fuel",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "surcharge",
          "label": "Fuel/Environmental Recovery Fee"
        },
        {
          "keywords": "environmental",
          "label": "Environmental Surcharge"
        }
      ],
      "default": "Scheduled Service"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "fuel",
          "label": "SURCHARGE"
        },
        {
          "keywords": "surcharge",
          "label": "SURCHARGE"
        },
        {
          "keywords": "environmental",
          "label": "SURCHARGE"
        }
      ],
      "default": "RECURRING"
    },
    "schedule_default": {
      "type": "keyword_classify",
      "source_field": "equipment_type",
      "output_field": "schedule",
      "rules": []
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": "(\\d{1,2}/\\d{1,2}/\\d{4})",
      "date_format": "{0}",
      "require_date": false
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|([\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "skip_patterns": [
      "Previous\\s+Balance",
      "Payment",
      "^\\s*$"
    ],
    "per_charge_transforms": [
      "date_service",
      "equipment_detect",
      "schedule_default",
      "material_detect",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": []
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
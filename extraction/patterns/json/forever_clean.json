{
  "format_label": "forever_clean",
  "vendor_name": "Forever Clean",
  "routing_regex": "FOREVER\\s+CLEAN",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "Invoice\\s+#\\s+(?P<invoice_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "Invoice\\s+Date\\s+(?P<invoice_date>[A-Za-z]+\\s+\\d{1,2},?\\s*\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "account_number",
      "method": "search",
      "pattern": "Customer\\s+ID[^\\n]*\\n\\s*(?P<account_number>C\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "Invoice\\s+Amount\\s+\\$(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "Site:\\s+[^,]+,\\s+(?P<service_address>[^\\n]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "service_address": "service_address"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "Line\\s+#\\s+Service\\s+Tax\\s+Code\\s+Rate\\s+Qty\\.?\\s+Amount\\s*\\n(.*?)Invoice\\s+Subtotal",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%b %d, %Y",
        "%b %d %Y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "fel",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "rl",
          "label": "REAR_LOAD"
        },
        {
          "keywords": "cart",
          "label": "CART"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "equipment_size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "(\\d+)\\s*YD",
      "group": 1
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "occ",
          "label": "OCC"
        },
        {
          "keywords": "recycl",
          "label": "RECYCLING"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        }
      ],
      "default": "MSW"
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "rent",
          "label": "Monthly Rental Commercial"
        }
      ],
      "default": "Monthly Service Commercial"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [],
      "default": "RECURRING"
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": null,
      "require_date": false
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$([\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "skip_patterns": [
      "^\\s*$"
    ],
    "line_join_config": {
      "new_line_pattern": "^\\d+\\s+\\S+.*\\$"
    },
    "per_charge_transforms": [
      "equipment_detect",
      "equipment_size_extract",
      "material_detect",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": []
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}
{
  "format_label": "wb_waste",
  "vendor_name": "WB Waste Solutions",
  "routing_regex": "WB\\s+Waste\\s+Solutions",
  "routing_flags": [
    "IGNORECASE",
    "DOTALL"
  ],
  "extraction_stages": [
    {
      "name": "account_number",
      "method": "search",
      "pattern": "CUSTOMER\\s+NO\\s+(?P<account_number>\\d+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "account_number": "account_number"
      }
    },
    {
      "name": "invoice_number",
      "method": "search",
      "pattern": "(?P<account_ref>\\d{9,})\\s+\\d+/\\d+/\\d{4}\\s+(?P<invoice_number>\\d{10,})\\s+\\$",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_number": "invoice_number"
      }
    },
    {
      "name": "bill_total",
      "method": "search",
      "pattern": "Total\\s+New\\s+Charges:\\s+\\$?(?P<bill_total>[\\d,]+\\.\\d{2})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "bill_total": "bill_total"
      }
    },
    {
      "name": "invoice_date",
      "method": "search",
      "pattern": "CUSTOMER\\s+NO\\s+\\d+\\s*\\nWB\\s+Waste[^\\n]*?(?P<invoice_date>\\d{1,2}/\\d{1,2}/\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      }
    },
    {
      "name": "invoice_date_alt",
      "method": "search",
      "pattern": "CUSTOMER\\s+PO[^\\n]*\\n\\s*(?P<invoice_date>\\d{1,2}/\\d{1,2}/\\d{4})",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "invoice_date": "invoice_date"
      },
      "skip_if_set": [
        "invoice_date"
      ]
    },
    {
      "name": "service_address",
      "method": "search",
      "pattern": "Site\\s+\\d+-\\d+\\s+-\\s+[^-]+-\\s+(?P<service_address>[^\\n]+)",
      "flags": [
        "IGNORECASE"
      ],
      "field_map": {
        "service_address": "service_address"
      }
    },
    {
      "name": "body",
      "method": "body_extract",
      "pattern": "Site\\s+\\d+-\\d+\\s+-[^\\n]+\\n(.*?)Total\\s+New\\s+Charges",
      "flags": [
        "IGNORECASE",
        "DOTALL"
      ],
      "output_field": "body",
      "group": 1
    }
  ],
  "execution_plan": [
    "bill_total_parse",
    "date_format"
  ],
  "transform_rules": {
    "bill_total_parse": {
      "type": "currency_parse",
      "field": "bill_total",
      "strip_dollar": true,
      "strip_comma": true
    },
    "date_format": {
      "type": "date_parse",
      "field": "invoice_date",
      "formats": [
        "%m/%d/%Y",
        "%-m/%-d/%Y"
      ]
    },
    "date_service": {
      "type": "date_parse",
      "field": "service_date",
      "formats": [
        "%m/%d/%Y"
      ]
    },
    "equipment_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "equipment_type",
      "rules": [
        {
          "keywords": "front load",
          "label": "FRONT_LOAD"
        },
        {
          "keywords": "rear load",
          "label": "REAR_LOAD"
        },
        {
          "keywords": "roll off",
          "label": "OPEN_TOP"
        },
        {
          "keywords": "cart",
          "label": "CART"
        }
      ],
      "default": "FRONT_LOAD"
    },
    "equipment_size_extract": {
      "type": "regex_capture",
      "source_field": "description",
      "output_field": "equipment_size",
      "pattern": "(\\d+)YD",
      "group": 1
    },
    "material_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "material",
      "rules": [
        {
          "keywords": "recycle",
          "label": "RECYCLING"
        },
        {
          "keywords": "cardboard",
          "label": "OCC"
        },
        {
          "keywords": "organic",
          "label": "ORGANICS"
        }
      ],
      "default": "MSW"
    },
    "schedule_detect": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "schedule",
      "rules": [
        {
          "keywords": "every 2 weeks",
          "label": "Biweekly"
        },
        {
          "keywords": "6x weekly",
          "label": "Weekly x6"
        },
        {
          "keywords": "5x weekly",
          "label": "Weekly x5"
        },
        {
          "keywords": "4x weekly",
          "label": "Weekly x4"
        },
        {
          "keywords": "3x weekly",
          "label": "Weekly x3"
        },
        {
          "keywords": "2x weekly",
          "label": "Weekly x2"
        },
        {
          "keywords": "weekly",
          "label": "Weekly x1"
        }
      ]
    },
    "charge_code_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_code",
      "rules": [
        {
          "keywords": "fuel surcharge",
          "label": "FUEL SURCHARGE"
        },
        {
          "keywords": "tax",
          "label": "Tax Commercial"
        }
      ],
      "default": "Monthly Service Commercial"
    },
    "charge_type_classify": {
      "type": "keyword_classify",
      "source_field": "description",
      "output_field": "charge_type",
      "rules": [
        {
          "keywords": "fuel",
          "label": "SURCHARGE"
        },
        {
          "keywords": "tax",
          "label": "TAX"
        }
      ],
      "default": "RECURRING"
    }
  },
  "charge_pipeline": {
    "source_field": "body",
    "charge_detect": {
      "date_pattern": "(\\d{2}/\\d{2}/\\d{4})",
      "date_format": "{0}",
      "require_date": false
    },
    "charge_extract": {
      "amount_pattern": "\\(\\$?([\\d,]+\\.\\d{2})\\)|\\$([\\d,]+\\.\\d{2})",
      "amount_mode": "last_is_total"
    },
    "skip_patterns": [
      "^\\s*$",
      "^\\s*\\$0\\.00\\s*$"
    ],
    "per_charge_transforms": [
      "date_service",
      "equipment_detect",
      "equipment_size_extract",
      "material_detect",
      "schedule_detect",
      "charge_code_classify",
      "charge_type_classify"
    ],
    "post_processing": []
  },
  "output_spec": {
    "header_fields": [
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "service_address"
    ],
    "charge_fields": [
      "service_date",
      "description",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "weight",
      "weight_unit",
      "charge_code",
      "charge_type"
    ],
    "csv_columns": [
      "pdf_filename",
      "pdf_link",
      "invoice_number",
      "invoice_date",
      "account_number",
      "bill_total",
      "charge_sum",
      "num_charges",
      "valid",
      "diff",
      "service_date",
      "description",
      "charge_type",
      "charge_total",
      "equipment_type",
      "equipment_size",
      "material",
      "schedule",
      "charge_code",
      "weight",
      "weight_unit",
      "flag",
      "service_address"
    ],
    "required_header": [
      "invoice_number",
      "bill_total"
    ],
    "required_charge": [
      "charge_total"
    ],
    "charge_sum_check": true,
    "total_field": "bill_total"
  }
}